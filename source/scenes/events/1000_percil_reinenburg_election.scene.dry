Q.nsdap_per_old = Q.nsdap_per;
Q.other_per_old = Q.other_per;
Q.gnvp_per_old = Q.gnvp_per;
Q.blpm_per_old = Q.blpm_per;
Q.pnf_per_old = Q.pnf_per;

Q.spd_per = 0;
Q.asum_per = 0;
Q.spm_per = 0;
Q.sapd_per = 0;
Q.ddp_per = 0;
Q.ppu_per = 0;
Q.z_per = 0;
Q.dvp_per = 0;
Q.dnvp_per = 0;
Q.nsdap_per = 0;
Q.other_per = 0;
Q.gnvp_per = 0;
Q.blpm_per = 0;
Q.pnf_per = 0;

Q.spd_per = (Q.workers_spd * Q.workers * 0.8) + (Q.old_middle_spd * Q.old_middle * 1.0) + (Q.new_middle_spd * Q.new_middle * 1.0) + (Q.peasants_spd * Q.peasants * 0.6) + (Q.rural_spd * Q.rural * 0.8) + (Q.catholics_spd * Q.catholics * 0.8) + (Q.minorieties_spd * Q.minorieties * 1.0) + (Q.unemployed_spd * Q.unemployed * 0.8) + (Q.spd_per_mod * 10);
Q.sapd_per = (Q.workers_sapd * Q.workers * 0.8) + (Q.old_middle_sapd * Q.old_middle * 1.0) + (Q.new_middle_sapd * Q.new_middle * 1.0) + (Q.peasants_sapd * Q.peasants * 0.6) + (Q.rural_sapd * Q.rural * 0.8) + (Q.catholics_sapd * Q.catholics * 0.8) + (Q.minorieties_sapd * Q.minorieties * 1.0) + (Q.unemployed_sapd * Q.unemployed * 0.8) + (Q.sapd_per_mod * 10);
Q.spm_per = (Q.workers_spm * Q.workers * 0.8) + (Q.old_middle_spm * Q.old_middle * 1.0) + (Q.new_middle_spm * Q.new_middle * 1.0) + (Q.peasants_spm * Q.peasants * 0.6) + (Q.rural_spm * Q.rural * 0.8) + (Q.catholics_spm * Q.catholics * 0.8) + (Q.minorieties_spm * Q.minorieties * 1.0) + (Q.unemployed_spm * Q.unemployed * 0.8) + (Q.spm_per_mod * 10);
Q.asum_per = (Q.workers_asum * Q.workers * 0.8) + (Q.old_middle_asum * Q.old_middle * 1.0) + (Q.new_middle_asum * Q.new_middle * 1.0) + (Q.peasants_asum * Q.peasants * 0.6) + (Q.rural_asum * Q.rural * 0.8) + (Q.catholics_asum * Q.catholics * 0.8) + (Q.minorieties_asum * Q.minorieties * 1.0) + (Q.unemployed_asum * Q.unemployed * 0.8) + (Q.asum_per_mod * 10);
Q.ddp_per = (Q.workers_ddp * Q.workers * 0.8) + (Q.old_middle_ddp * Q.old_middle * 1.0) + (Q.new_middle_ddp * Q.new_middle * 1.0) + (Q.peasants_ddp * Q.peasants * 0.6) + (Q.rural_ddp * Q.rural * 0.8) + (Q.catholics_ddp * Q.catholics * 0.8) + (Q.minorieties_ddp * Q.minorieties * 1.0) + (Q.unemployed_ddp * Q.unemployed * 0.8) + (Q.ddp_per_mod * 10);
Q.z_per = (Q.workers_z * Q.workers * 0.8) + (Q.old_middle_z * Q.old_middle * 1.0) + (Q.new_middle_z * Q.new_middle * 1.0) + (Q.peasants_z * Q.peasants * 0.6) + (Q.rural_z * Q.rural * 0.8) + (Q.catholics_z * Q.catholics * 0.8) + (Q.minorieties_z * Q.minorieties * 1.0) + (Q.unemployed_z * Q.unemployed * 0.8) + (Q.z_per_mod * 10);
Q.dvp_per = (Q.workers_dvp * Q.workers * 0.8) + (Q.old_middle_dvp * Q.old_middle * 1.0) + (Q.new_middle_dvp * Q.new_middle * 1.0) + (Q.peasants_dvp * Q.peasants * 0.6) + (Q.rural_dvp * Q.rural * 0.8) + (Q.catholics_dvp * Q.catholics * 0.8) + (Q.minorieties_dvp * Q.minorieties * 1.0) + (Q.unemployed_dvp * Q.unemployed * 0.8) + (Q.dvp_per_mod * 10);
Q.dnvp_per = (Q.workers_dnvp * Q.workers * 0.8) + (Q.old_middle_dnvp * Q.old_middle * 1.0) + (Q.new_middle_dnvp * Q.new_middle * 1.0) + (Q.peasants_dnvp * Q.peasants * 0.6) + (Q.rural_dnvp * Q.rural * 0.8) + (Q.catholics_dvp * Q.catholics * 0.8) + (Q.minorieties_dnvp * Q.minorieties * 1.0) + (Q.unemployed_dnvp * Q.unemployed * 0.8) + (Q.dnvp_per_mod * 10);
Q.nsdap_per = (Q.workers_nsdap * Q.workers * 0.8) + (Q.old_middle_nsdap * Q.old_middle * 1.0) + (Q.new_middle_nsdap * Q.new_middle * 1.0) + (Q.peasants_nsdap * Q.peasants * 0.6) + (Q.rural_nsdap * Q.rural * 0.8) + (Q.catholics_nsdap * Q.catholics * 0.8) + (Q.minorieties_nsdap * Q.minorieties * 1.0) + (Q.unemployed_nsdap * Q.unemployed * 0.8) + (Q.nsdap_per_mod * 10);
Q.gnvp_per = (Q.workers_gnvp * Q.workers * 0.8) + (Q.old_middle_gnvp * Q.old_middle * 1.0) + (Q.new_middle_gnvp * Q.new_middle * 1.0) + (Q.peasants_gnvp * Q.peasants * 0.6) + (Q.rural_gnvp * Q.rural * 0.8) + (Q.catholics_gnvp * Q.catholics * 0.8) + (Q.minorieties_gnvp * Q.minorieties * 1.0) + (Q.unemployed_gnvp * Q.unemployed * 0.8) + (Q.gnvp_per_mod * 10);
Q.blpm_per = (Q.workers_blpm * Q.workers * 0.8) + (Q.old_middle_blpm * Q.old_middle * 1.0) + (Q.new_middle_blpm * Q.new_middle * 1.0) + (Q.peasants_blpm * Q.peasants * 0.6) + (Q.rural_blpm * Q.rural * 0.8) + (Q.catholics_blpm * Q.catholics * 0.8) + (Q.minorieties_blpm * Q.minorieties * 1.0) + (Q.unemployed_blpm * Q.unemployed * 0.8) + (Q.blpm_per_mod * 10);
Q.other_per = (Q.workers_other * Q.workers * 0.8) + (Q.old_middle_other * Q.old_middle * 1.0) + (Q.new_middle_other * Q.new_middle * 1.0) + (Q.peasants_other * Q.peasants * 0.6) + (Q.rural_other * Q.rural * 0.8) + (Q.catholics_other * Q.catholics * 0.8) + (Q.minorieties_other * Q.minorieties * 1.0) + (Q.unemployed_other * Q.unemployed * 0.8) + (Q.other_per_mod * 10);

Q.ppu_per = ((Q.minorieties_ppu * Q.minorieties * 5.0) + (Q.workers_ppu * Q.workers * 1.5) + (Q.old_middle_ppu * Q.old_middle * 1.1) + (Q.new_middle_ppu * Q.new_middle * 1.1) + (Q.peasants_ppu * Q.peasants * 0.6) + (Q.rural_ppu * Q.rural * 0.8) + (Q.catholics_ppu * Q.catholics * 0.8) + (Q.minorieties_ppu * Q.minorieties * 0.5) + (Q.unemployed_ppu * Q.unemployed * 1.2) + (Q.ppu_per_mod * 10))*1.1;
Q.pnf_per = (Q.percil_radicalisation * 10) + (Q.pnf_per_mod * 10) + (Q.minorieties_ppu * Q.minorieties * 1.5);

Q.dnvp_per += Q.z_per*0.3;
Q.dvp_per += Q.z_per*0.6; 
Q.ddp_per += Q.z_per*0.1;
Q.ddp_per += Q.blpm_per;

Q.z_per = 0;
Q.blpm_per = 0;
             
Q.per_total = 0;

if (Q.spd_per) Q.per_total += Q.spd_per;
if (Q.asum_per) Q.per_total += Q.asum_per;
if (Q.spm_per) Q.per_total += Q.spm_per;
if (Q.sapd_per) Q.per_total += Q.sapd_per;
if (Q.ddp_per) Q.per_total += Q.ddp_per;
if (Q.ppu_per) Q.per_total += Q.ppu_per;
if (Q.z_per) Q.per_total += Q.z_per;
if (Q.dvp_per) Q.per_total += Q.dvp_per;
if (Q.dnvp_per) Q.per_total += Q.dnvp_per;
if (Q.nsdap_per) Q.per_total += Q.nsdap_per;
if (Q.other_per) Q.per_total += Q.other_per;
if (Q.gnvp_per) Q.per_total += Q.gnvp_per;
if (Q.blpm_per) Q.per_total += Q.blpm_per;
if (Q.pnf_per) Q.per_total += Q.pnf_per;

if (Q.per_total > 0) {
    Q.spd_per = (Q.spd_per / Q.per_total) * 100;
    Q.spm_per = (Q.spm_per / Q.per_total) * 100;
    Q.sapd_per = (Q.sapd_per / Q.per_total) * 100;
    Q.asum_per = (Q.asum_per / Q.per_total) * 100;
    Q.ddp_per = (Q.ddp_per / Q.per_total) * 100;
    Q.ppu_per = (Q.ppu_per / Q.per_total) * 100;
    Q.z_per = (Q.z_per / Q.per_total) * 100;
    Q.dvp_per = (Q.dvp_per / Q.per_total) * 100;
    Q.dnvp_per = (Q.dnvp_per / Q.per_total) * 100;
    Q.nsdap_per = (Q.nsdap_per / Q.per_total) * 100;
    Q.other_per = (Q.other_per / Q.per_total) * 100;
    Q.gnvp_per = (Q.gnvp_per / Q.per_total) * 100;
    Q.blpm_per = (Q.blpm_per / Q.per_total) * 100;
    Q.pnf_per = (Q.pnf_per / Q.per_total) * 100;
}

Q.kpm_coa = (Q.kpm_modifier*Q.sapd_relation) + 5;
Q.spm_coa = (Q.spm_modifier*Q.spm_relation) + 5;
Q.fvp_coa = (Q.fvp_modifier*Q.ddp_relation) + 5;
Q.ppu_coa = (Q.ppu_relation) + 5;
Q.pnf_coa = (Q.ppu_relation) - 10;
Q.ldp_coa = (Q.ldp_modifier*Q.dvp_relation*Q.gdsu_modifier) + 5;

if (Q.spm_ally) {
    Q.spm_coa += 20;
    }
if (Q.kpm_ally) {
    Q.kpm_coa += 20;
    }
if (Q.ppu_ally) {
    Q.ppu_coa += 20;
    }
if (Q.fvp_ally) {
    Q.fvp_coa += 20;
    }

if (Q.sapd_formed == 0) {
    Q.fvp_coa -= 10;
    }
if (Q.sapd_formed == 0) {
    Q.gdsu_coa -= 20;
    }
if (Q.sapd_formed == 0) {
    Q.ppu_coa -= 20;
    }
if (Q.sapd_formed == 0) {
    Q.ldp_coa -= 30;
    }

if (Q.party_policy_fed == 2) {
    Q.ppu_coa += 10;
    Q.pnf_coa += 15;
    }
if (Q.party_policy_fed == 0) {
    Q.ppu_coa -= 10;
    Q.pnf_coa -= 15;
    }

Q.kpm_coa += Q.party_policy_main*2;
Q.spm_coa -= Q.party_policy_main;

Q.coa_tention = 0;

Q.spd_per = (Q.spd_per != undefined ? parseFloat(Q.spd_per.toFixed(1)) : 0);
Q.spm_per = (Q.spm_per != undefined ? parseFloat(Q.spm_per.toFixed(1)) : 0);
Q.sapd_per = (Q.sapd_per != undefined ? parseFloat(Q.sapd_per.toFixed(1)) : 0);
Q.asum_per = (Q.asum_per != undefined ? parseFloat(Q.asum_per.toFixed(1)) : 0);
Q.ddp_per = (Q.ddp_per != undefined ? parseFloat(Q.ddp_per.toFixed(1)) : 0);
Q.ppu_per = (Q.ppu_per != undefined ? parseFloat(Q.ppu_per.toFixed(1)) : 0);
Q.z_per = (Q.z_per != undefined ? parseFloat(Q.z_per.toFixed(1)) : 0);
Q.dvp_per = (Q.dvp_per != undefined ? parseFloat(Q.dvp_per.toFixed(1)) : 0);
Q.dnvp_per = (Q.dnvp_per != undefined ? parseFloat(Q.dnvp_per.toFixed(1)) : 0);
Q.nsdap_per = (Q.nsdap_per != undefined ? parseFloat(Q.nsdap_per.toFixed(1)) : 0);
Q.other_per = (Q.other_per != undefined ? parseFloat(Q.other_per.toFixed(1)) : 0);
Q.gnvp_per = (Q.gnvp_per != undefined ? parseFloat(Q.gnvp_per.toFixed(1)) : 0);
Q.blpm_per = (Q.blpm_per != undefined ? parseFloat(Q.blpm_per.toFixed(1)) : 0);
Q.pnf_per = (Q.pnf_per != undefined ? parseFloat(Q.pnf_per.toFixed(1)) : 0);

Q.per_change_spd = Q.spd_per - Q.spd_per_old;
Q.per_change_sapd = Q.sapd_per - Q.sapd_per_old;
Q.per_change_spm = Q.spm_per - Q.spm_per_old;
Q.per_change_asum = Q.asum_per - Q.asum_per_old;
Q.per_change_ddp = Q.ddp_per - Q.ddp_per_old;
Q.per_change_z = Q.z_per - Q.z_per_old;
Q.per_change_blpm = Q.blpm_per - Q.blpm_per_old;
Q.per_change_ppu = Q.ppu_per - Q.ppu_per_old;
Q.per_change_dvp = Q.dvp_per - Q.dvp_per_old;
Q.per_change_dnvp = Q.dnvp_per - Q.dnvp_per_old;
Q.per_change_nsdap = Q.nsdap_per - Q.nsdap_per_old;
Q.per_change_other = Q.other_per - Q.other_per_old;
Q.per_change_gnvp = Q.gnvp_per - Q.gnvp_per_old;
Q.per_change_pnf = Q.pnf_per - Q.pnf_per_old;

Q.left_coalition_per = (Q.spd_per + Q.sapd_per + Q.spm_per + Q.asum_per).toFixed(1);
Q.popular_front_coalition_per = (Q.spd_per + Q.sapd_per + Q.spm_per + Q.asum_per + Q.ppu_per + Q.ddp_per).toFixed(1);
Q.weimar_coalition_per = (Q.spd_per + Q.ddp_per + Q.ppu_per + Q.spm_per).toFixed(1);
Q.minority_coalition = (Q.spd_per + Q.sapd_per + Q.spm_per + Q.asum_per + Q.ppu_per + Q.pnf_per).toFixed(1);
Q.grand_coalition_per = (Q.spd_per + Q.spm_per + Q.ddp_per + Q.ppu_per + Q.dvp_per).toFixed(1);

Q.liberal_coalition_per = (Q.ddp_per + Q.dvp_per + Q.ppu_per).toFixed(1); 
Q.wide_liberal_coalition_per = (Q.ddp_per + Q.dvp_per + Q.ppu_per + Q.other_per).toFixed(1);
Q.center_right_coalition_per = (Q.dvp_per + Q.other_per + Q.dnvp_per + Q.gnvp_per).toFixed(1);
Q.anti_democratic_coalition_per = (Q.nsdap_per + Q.dnvp_per + Q.sapd_per);
if (Q.liberal_reconciliation <= 12) {Q.anti_democratic_coalition_per = Q.anti_democratic_coalition_per + Q.spd_per/2;}
Q.anti_democratic_coalition_per = (Q.anti_democratic_coalition_per).toFixed(1);Q.hitler_right_coalition_per = (Q.dnvp_per + Q.nsdap_per + Q.dvp_per + Q.other_per + Q.gnvp_per).toFixed(1);

Q.per_change_spd = (Q.per_change_spd != undefined ? parseFloat(Q.per_change_spd.toFixed(1)) : 0);
Q.per_change_spm = (Q.per_change_spm != undefined ? parseFloat(Q.per_change_spm.toFixed(1)) : 0);
Q.per_change_sapd = (Q.per_change_sapd != undefined ? parseFloat(Q.per_change_sapd.toFixed(1)) : 0);
