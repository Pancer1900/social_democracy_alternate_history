Q.per_change_dnvp = (Q.per_change_dnvp != undefined ? parseFloat(Q.per_change_dnvp.toFixed(1)) : 0);
Q.per_change_nsdap = (Q.per_change_nsdap != undefined ? parseFloat(Q.per_change_nsdap.toFixed(1)) : 0);
Q.per_change_other = (Q.per_change_other != undefined ? parseFloat(Q.per_change_other.toFixed(1)) : 0);
