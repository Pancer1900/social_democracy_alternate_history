Q.custom_coalition_per = Q.spd_per;

!}
on-display: {!
data = [];
data = data.concat([
    {
        "id": "pnf",
        "legend": "PNF",
        "name": "PNF",
        "seats": Math.round(Q.pnf_per*1.5),
    },
    ]);
if (Q.sapd_formed && Q.sapd_per) {
    data.push({
            "id": "sapd",
            "legend": "KPM",
            "name": "KPM",
            "seats": Math.round(Q.sapd_per*1.5),
            });
}
if (Q.asum_formed && Q.asum_per) {
    data.push({
            "id": "asum",
            "legend": "ASUM",
            "name": "ASUM",
            "seats": Math.round(Q.asum_per*1.5),
            });
}
data = data.concat([
    {
        "id": "spd",
        "legend": Q.spd_name,
        "name": Q.spd_name,
        "seats": Math.round(Q.spd_per*1.5),
    },
    ]);
if (Q.spm_formed && Q.spm_per) {
    data.push({
            "id": "spm",
            "legend": "SPM",
            "name": "SPM",
            "seats": Math.round(Q.spm_per*1.5),
            });
}
data = data.concat([
    {
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Math.round(Q.ddp_per*1.5),
    },
    ]);
data = data.concat([
    {
        "id": "bvp",
        "legend": "PPU",
        "name": "PPU",
        "seats": Math.round(Q.ppu_per*1.5),
    },
    {
        "id": "dvp",
        "legend": Q.dvp_name,
        "name": Q.dvp_name,
        "seats": Math.round(Q.dvp_per*1.5),
    },
    {
        "id": "other",
        "legend": "Other",
        "name": "Other",
        "seats": Math.round(Q.other_per*1.5),
    },
]);
if (Q.gnvp_formed && Q.gnvp_per) {
    data.push({
            "id": "gnvp",
            "legend": "GNVP",
            "name": "GNVP",
            "seats": Math.round(Q.gnvp_per*1.5),
            });
}
data = data.concat([
    {
        "id": "dnvp",
        "legend": "MNVP",
        "name": "MNVP",
        "seats": Math.round(Q.dnvp_per*1.5),
    },
    {
        "id": "nsdap",
        "legend": "NSDAP",
        "name": "NSDAP",
        "seats": Math.round(Q.nsdap_per*1.5),
    },
]);


if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("saxony_landtag").style.height = screenWidth/1.5 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#saxony_landtag").datum(data).call(parliament);
}
!}
go-to: coalition_menu

**Percil-Reinenburg Caversket:**

{!<svg id="saxony_landtag" style="width: 500px; height: 250px;"> </svg>!}

{!<table>!} 
{!<tr><td>Party</td><td>Vote share</td><td>% Change</td></tr>!}
{!<tr><td><div class="box" style='background-color:#dc0100; outline: 2px; outline-style: solid;'> </div> !} **[+ spd_name +]:** {!</td><td>!} **[+ spd_per +]%** {!</td><td>!} **[+ per_change_spd +]** {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#a302a6'> </div> !} PNF: {!</td><td>!} [+ pnf_per +]% {!</td><td>!} [+ per_change_pnf +] {!</td></tr>!}

[? if sapd_formed : {!<tr><td><div class="box" style='background-color:#920002'> </div> !}KPM: {!</td><td>!} [+ sapd_per +]% {!</td><td>!} [+ per_change_sapd +] {!</td></tr>!} ?]

[? if asum_formed : {!<tr><td><div class="box" style='background-color:#dd5b00'> </div> !}ASUM: {!</td><td>!} [+ asum_per +]% {!</td><td>!} [+ per_change_asum +] {!</td></tr>!} ?]

[? if spm_formed : {!<tr><td><div class="box" style='background-color:#dc0200'> </div> !}SPM: {!</td><td>!} [+ spm_per +]% {!</td><td>!} [+ per_change_spm +] {!</td></tr>!} ?]

{!<tr><td><div class="box" style='background-color:#ddd500'> </div> !} [+ ddp_name +]: {!</td><td>!} [+ ddp_per +]% {!</td><td>!} [+ per_change_ddp +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#4b9ee0'> </div> !} PPU: {!</td><td>!} [+ ppu_per +]% {!</td><td>!} [+ per_change_ppu +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#caa58b'> </div> !} Liberal-Gecherdist Liste: {!</td><td>!} [+ dvp_per +]% {!</td><td>!} [+ per_change_dvp +] {!</td></tr>!}
 
{!<tr><td><div class="box" style='background-color:#dddddd'> </div> !} Others: {!</td><td>!} [+ other_per +] % {!</td><td>!} [+ per_change_other +] {!</td></tr>!}

[? if gnvp_formed : {!<tr><td><div class="box" style='background-color:#774ae2'> </div> !}GNVP: {!</td><td>!} [+ gnvp_per +]% {!</td><td>!} [+ per_change_gnvp +] {!</td></tr>!} ?]

{!<tr><td><div class="box" style='background-color:#1125e0'> </div> !} MNVP: {!</td><td>!} [+ dnvp_per +]% {!</td><td>!} [+ per_change_dnvp +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#706a65'> </div> !} NSDAP: {!</td><td>!} [+ nsdap_per +]% {!</td><td>!} [+ per_change_nsdap +] {!</td></tr>!}
{!</table>!}

**Potential coalitions:**

Zeltbrin Coalition (<span style="color: #dc0200;">**[+ spd_name +]**</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span>): [+ weimar_coalition_per +]%

[? if liberal_reconciliation >= 18: Grand Coalition (<span style="color: #dc0200;">**[+ spd_name +]**</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span> + <span style="color: #4a9fde;">PPU</span> + <span style="color: #caa58b;">LDP</span>[? if blpm_formed = 1 : + <span style="color: #00e8ff;">BLPM</span> ?] ): [+ grand_coalition_per +]% ?]

Liberal Coalition (<span style="color: #caa58b;">LDP</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span> + <span style="color: #4a9fde;">PPU</span>): [+ liberal_coalition_per +]%

[? if liberal_coalition < 50 : Wide - Liberal Coalition (<span style="color: #caa58b;">LDP</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span> + <span style="color: #4a9fde;">PPU</span> + others): [+ wide_liberal_coalition_per +]% ?]

Center-Right Coalition (<span style="color: #48b94a;">GDSU</span> + <span style="color: #caa58b;">LDP</span> + <span style="color: #4a9fde;">PPU</span> + others + <span style="color: #3F7BC1;">MNVP</span> [? if gnvp_formed = 1 : + <span style="color: #774ae2;">GNVP</span>  ?][? if blpm_formed = 1 : + <span style="color: #00e8ff;">BLPM</span>  ?]): [+ center_right_coalition_per +]%

[? if anti_democratic_coalition >= 50 : Together, the anti-democratic KPD, DNVP, and NSDAP have a majority in the Reichstag. A stable governing majority will be almost impossible. ?]

There are some potential coalition arrangements.

@coalition_menu

-@spd: We achived a <span style="color: #dc0200;">**[+ spd_name +]**</span> majority!
-@left: We achived a <span style="color: #d61818;">Socialist</span> majority of all the left wing patries!
-@popu: We can try to form the Popular Front bettwen the <span style="color: #48b94a;">GDSU</span>,<span style="color: #ddd500;">FVP</span> and other leftists parties.
-@zelt: Zeltbrin coalition could be possible. 
-@grand: Maybe the reactionary Grand coalition? 
-@lib: The Liberal coalition is formed. 
-@lib_whide: The liberals can form a wide coalition. 
-@cent_right: Center right coalition could form. 
-@far_right: This is the end....
-@no_majority: There is no possilbe majority. 
-@coalition: Maybe we can try some other coalition?

@no_majority
view-if: anti_democratic_coalition_per >= 45 or (liberal_unity + liberal_right) < 80
subtitle: This would mean the continuation of the current goverment with federal support and next election will be called in half of a year.
on-arrival: pro_republic -= 2; ddp_per_gov = 1 if percil_gov  = 1; spd_per_gov = 1 if percil_gov  = 1; spm_per_gov = 1 if percil_gov  = 1; ddp_per_gov = 1 if percil_gov  = 2; z_per_gov = 1 if percil_gov  = 2; dvp_per_gov = 1 if percil_gov  = 2; ppu_per_gov = 1 if percil_gov  = 2; other_per_gov = 1 if percil_gov  = 2; z_per_gov = 1 if percil_gov  = 3; dvp_per_gov = 1 if percil_gov  = 3; other_per_gov = 1 if percil_gov  = 3; dnvp_per_gov = 1 if percil_gov  = 3; ddp_per_gov = 1 if percil_gov  = 2; nsdap_per_mod += 25; sapd_per_mod += 15;

@spd
view-if: spd_per >= 50
on-arrival: spd_per_gov = 1; percil_gov  = 1; local_spd = 1; workers_spd += 3; new_middle_spd += 2.5; rural_spd += 2; 

@left
subtitle: [+ spd_name +][? if sapd_formed : + <span style="color: #940000;">KPM</span> ?][? if asum_formed: + <span style="color: #dd5b00;">ASUM</span> ?][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?]([+ left_coalition_per +]%)
view-if: left_coalition_per >= 45 and (sapd_formed > 0 or spm_formed > 0)
choose-if: left_coalition_per >= 50 and (kpm_coa + spm_coa) >= 130
unavailable-subtitle: [? if (kpm_coa + spm_coa) < 130: We do not have good enough relations with the other socialist parties. ?]
on-arrival: spd_per_gov = 1; percil_gov  = 1; local_spd = 1; asum_per_gov = 1; spm_per_gov = 1; sapd_per_gov = 1; liberal_unity += 3; sapd_relation += 3*kpm_modifier; dvp_relation -= 3*ldp_modifier; z_relation -= 2*gdsu_modifier; ppu_relation -= 1; ddp_relation -= 1; workers_spd += 2.5; new_middle_spd += 2; rural_spd += 1;  peasants_asum += 1.5; rural_asum += 1; workers_sapd += 2.5; workers_spm += 1; new_middle_spm += 1;

@prog_fro
subtitle: [+ spd_name +][? if sapd_formed : + <span style="color: #940000;">KPM</span> ?][? if asum_formed: + <span style="color: #dd5b00;">ASUM</span> ?][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> ([+ progressive_front_per +]%)
view-if: progressive_front_per >= 45 and sapd_formed > 0
choose-if: progressive_front_per >= 50 and (kpm_coa + spm_coa) >= 140 and ddp_coa >= 75 and liberal_reconciliation >= 10
unavailable-subtitle: [? if (kpm_coa + spm_coa) < 140: We do not have good enough relations with the other socialist parties. ?][? if ddp_coa < 75: We do not have good enough relations with the <span style="color: #ddd500;">FVP</span>. ?]
on-arrival: spd_per_gov = 1; percil_gov  = 1; local_spd = 1; asum_per_gov = 1; spm_per_gov = 1; sapd_per_gov = 1; ddp_per_gov = 1; liberal_unity += 1; sapd_relation += 2*kpm_modifier; dvp_relation -= 2.5*ldp_modifier; z_relation -= 1.5*gdsu_modifier; ppu_relation -= 1;  ddp_relation += 1; new_middle_ddp += 2; new_middle_spd += 2; workers_spd += 2.5; workers_spm += 1; new_middle_spm += 1; workers_ddp += 1; peasants_asum += 1; rural_asum += 1; workers_sapd += 2;

@popu
subtitle: [+ spd_name +][? if sapd_formed : + <span style="color: #940000;">KPM</span> ?][? if asum_formed: + <span style="color: #dd5b00;">ASUM</span> ?][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> + <span style="color: #48ba48;">GDSU</span> ([+ popular_front_coalition_per +]%)
view-if: popular_front_coalition_per >= 45 and sapd_formed > 0
choose-if: popular_front_coalition_per >= 50 and (kpm_coa + spm_coa) >= 150 and ddp_coa >= 80 and gdsu_coa >= 80 and liberal_reconciliation >= 18
unavailable-subtitle: [? if (kpm_coa + spm_coa) < 150: We do not have good enough relations with the other socialist parties. ?][? if gdsu_coa < 75: We do not have good enough relations with the <span style="color: #48ba48;">GDSU</span>. ?][? if fvp_coa < 75: We do not have good enough relations with the <span style="color: #ddd500;">FVP</span>. ?][? if liberal_reconciliation < 18: The Liberal Parties do not trust us enough to enter into a goverment with communists. ?]
on-arrival: spd_per_gov = 1; percil_gov  = 1; local_spd = 1; asum_per_gov = 1; spm_per_gov = 1; sapd_per_gov = 1; ddp_per_gov = 1; z_per_gov = 1; liberal_unity += 3; sapd_relation += 2*kpm_modifier; dvp_relation -= 3*ldp_modifier; z_relation -= 1*gdsu_modifier;  ddp_relation += 1; new_middle_ddp += 1; new_middle_spd += 2; workers_spd += 2; workers_spm += 1; new_middle_spm += 0.5; workers_ddp += 1; workers_z += 1; rural_z += 1; peasants_asum += 1; rural_asum += 0.5; workers_sapd += 2;

@prog
subtitle: [+ spd_name +][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> ([+ progressive_coalition_per +]%)
view-if: progressive_coalition_per >= 45
choose-if: progressive_coalition_per >= 50 and ddp_coa >= 70 and liberal_reconciliation >= 8
unavailable-subtitle: We do not have good enough relations with the <span style="color: #ddd500;">FVP</span> and they do not trust us enough.
on-arrival: spd_per_gov = 1; percil_gov  = 1; local_spd = 1; spm_per_gov = 1; ddp_per_gov = 1; liberal_unity += 1; ddp_relation += 1; new_middle_ddp += 2; new_middle_spd += 2; workers_spd += 2.5; workers_spm += 1; new_middle_spm += 1; workers_ddp += 1;

@zelt
view-if: weimar_coalition_per >= 45 and liberal_reconciliation >= 8
subtitle: [+ spd_name +][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> + <span style="color: #48ba48;">GDSU</span> ([+ weimar_coalition_per +]%)
choose-if: weimar_coalition_per >= 50 and ddp_coa >= 65 and gdsu_coa >= 65 and liberal_reconciliation >= 12
unavailable-subtitle: [? if gdsu_coa < 75: We do not have good enough relations with the <span style="color: #48ba48;">GDSU</span>. ?][? if fvp_coa < 75: We do not have good enough relations with the <span style="color: #ddd500;">FVP</span>. ?][? if liberal_reconciliation < 10: The Liberal Parties do not trust us enough to enter into a goverment with us. ?]
on-arrival: spd_per_gov = 1; percil_gov  = 1; local_spd = 1; spm_per_gov = 1; ddp_per_gov = 1; z_per_gov = 1; sapd_relation -= 1*kpm_modifier; dvp_relation += 1*ldp_modifier; z_relation += 1.5*gdsu_modifier; ddp_relation += 1.5*fvp_modifier; old_middle_dvp += 1; rural_z += 1; peasnts_z += 1; new_middle_ddp += 1.5; workers_spd += 2; new_middle_spd += 1.5; workers_spm += 1;

@zelt_whide
view-if: zeltbrin_plus_coalition_per >= 50 and weimar_coalition_per <= 50 and liberal_reconciliation >= 8
subtitle: [+ spd_name +][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> + <span style="color: #48ba48;">GDSU</span> + <span style="color: #4b9fde;">PPU</span>[? if blpm_formed : + <span style="color: #00e8ff;">BLPM</span> ?]([+ weimar_coalition_per +]%)
choose-if: zeltbrin_plus_coalition_per >= 50 and ddp_coa >= 70 and gdsu_coa >= 70 and liberal_reconciliation >= 14 and ppu_coa >= 65
unavailable-subtitle: [? if gdsu_coa < 75: We do not have good enough relations with the <span style="color: #48ba48;">GDSU</span>. ?][? if fvp_coa < 75: We do not have good enough relations with the <span style="color: #ddd500;">FVP</span>. ?][? if liberal_reconciliation < 12: The Liberal Parties do not trust us enough to enter into a goverment with us. ?]
on-arrival: spd_per_gov = 1; percil_gov  = 1; local_spd = 1; spm_per_gov = 1; ddp_per_gov = 1; z_per_gov = 1; ppu_per_gov = 1; sapd_relation -= 2*kpm_modifier; dvp_relation += 1.5*ldp_modifier; z_relation += 1.5*gdsu_modifier; ppu_relation += 1.5; ddp_relation += 1.5*fvp_modifier; rural_z += 1; minorieties_ppu += 1; peasnts_z += 1; other_rural += 1; new_middle_ddp += 1.5; workers_spd += 2; new_middle_spd += 1.5; workers_spm += 1;

@grand
view-if: grand_coalition_per >= 50 and zeltbrin_plus_coalition_per <= 50 and liberal_reconciliation >= 16 and center_right_coalition_per <= 50
subtitle: [+ spd_name +][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> + <span style="color: #48ba48;">GDSU</span> + <span style="color: #4b9fde;">PPU</span>[? if blpm_formed : + <span style="color: #00e8ff;">BLPM</span> ?] + <span style="color: #caa58b;">[+ dvp_name +]</span> + Other([+ grand_coalition_per +]%)
choose-if: grand_coalition_per >= 50 and liberal_reconciliation >= 18 and (fvp_coa + gdsu_coa) >= 140 and ldp_coa >= 65 and ppu_coa >= 65 and ppu_coa >= 65 and other_coa >= 65
on-arrival: spd_per_gov = 1; percil_gov  = 1; local_spd = 1; spm_per_gov = 1; ddp_per_gov = 1; z_per_gov = 1; ppu_per_gov = 1; other_per_gov = 1; dvp_per_gov = 1; sapd_relation -= 3*kpm_modifier; dvp_relation += 2*ldp_modifier; z_relation += 2*gdsu_modifier; ppu_relation += 2; ddp_relation += 2*fvp_modifier; liberal_unity += 2; old_middle_dvp += 1; rural_z += 1; minorieties_ppu += 1; peasnts_z += 1; new_middle_dvp += 1; other_rural += 1; new_middle_ddp += 1.5; workers_spd += 1.5; new_middle_spd += 1.5; workers_spm += 1;
unavailable-subtitle: [? if (fvp_coa + gdsu_coa) <= 140: We do not have good enough relations with the left Liberals. ?][? if ldp_coa < 75: The LDP, is unwilling to compromise at all. ?][? if liberal_reconciliation < 18: The Liberal Parties do not trust us enough to enter into a goverment with us. ?]

@lib
view-if: liberal_coalition_per >= 45
subtitle: <span style="color: #ddd500;">FVP</span> + <span style="color: #48ba48;">GDSU</span> + <span style="color: #4b9fde;">PPU</span>[? if blpm_formed : + <span style="color: #00e8ff;">BLPM</span> ?] + <span style="color: #caa58b;">[+ dvp_name +]</span> ([+ liberal_coalition_per +]%)
choose-if: liberal_coalition_per >= 50 and liberal_unity >= 40
unavailable-subtitle: [? if liberal_unity <= 40: Liberals are too conflicted to form a coherent goverment ?]
on-arrival: percil_gov  = 2; ddp_per_gov = 1; z_per_gov = 1; ppu_per_gov = 1; dvp_per_gov = 1; liberal_unity += 2.5; old_middle_dvp += 1; rural_z += 1; minorieties_ppu += 1; peasnts_z += 1; new_middle_dvp += 1; new_middle_ddp += 2;

@lib_whide
subtitle: <span style="color: #ddd500;">FVP</span> + <span style="color: #48ba48;">GDSU</span> + <span style="color: #4b9fde;">PPU</span>[? if blpm_formed : + <span style="color: #00e8ff;">BLPM</span> ?] + <span style="color: #caa58b;">[+ dvp_name +]</span> + Other ([+ wide_liberal_coalition_per +]%)
view-if: wide_liberal_coalition_per >= 50 and liberal_coalition_per <= 50
choose-if: wide_liberal_coalition_per >= 50 and liberal_unity >= 40
unavailable-subtitle: [? if liberal_unity <= 40: Liberals are too conflicted to form a coherent goverment ?]
on-arrival: percil_gov  = 2; ddp_per_gov = 1; z_per_gov = 1; ppu_per_gov = 1; other_per_gov = 1; dvp_per_gov = 1; liberal_unity += 2; old_middle_dvp += 1; rural_z += 1; minorieties_ppu += 1; peasnts_z += 1; new_middle_dvp += 1; other_rural += 1; new_middle_ddp += 1.5;

@cent_right
subtitle: <span style="color: #48ba48;">GDSU</span> + <span style="color: #4b9fde;">PPU</span>[? if blpm_formed : + <span style="color: #00e8ff;">BLPM</span> ?] + <span style="color: #caa58b;">[+ dvp_name +]</span> + Other[? if gnvp_formed : + <span style="color: #774ae2;">GNVP</span> ?] + <span style="color: #1027dc;">MNVP</span> ([+ center_right_coalition_per +]%)
view-if: center_right_coalition_per >= 45
choose-if: center_right_coalition_per >= 50 and (dnvp_path - gdsu_ideology + 2 - ldp_ideology) >= 0 and liberal_unity >= 30 and liberal_right >= 35
unavailable-subtitle: [? if liberal_unity <= 30: Liberals are too conflicted to form a coherent goverment. ?][? if (dnvp_path - gdsu_ideology + 2 - ldp_ideology) < 0: Liberals are unwilling to compromise with the MNVP. ?]
on-arrival: percil_gov  = 3; z_per_gov = 1; ppu_per_gov = 1; other_per_gov = 1; dvp_per_gov = 1; gnvp_per_gov = 1; dnvp_per_gov = 1; old_middle_dvp += 1; rural_z += 1; peasnts_z += 1 ; rural_dnvp += 1; minorieties_ppu += 1; new_middle_dvp += 1; other_rural += 1;

@right
subtitle: <span style="color: #caa58b;">[+ dvp_name +]</span> + Other[? if gnvp_formed : + <span style="color: #774ae2;">GNVP</span> ?] + <span style="color: #1027dc;">MNVP</span> ([+ right_coalition_per +]%)
view-if: right_coalition_per >= 45
choose-if: right_coalition_per >= 50
on-arrival: percil_gov  = 3; other_per_gov = 1; dvp_per_gov = 1; gnvp_per_gov = 1; dnvp_per_gov = 1; liberal_unity -= 2;

@far_right
subtitle: <span style="color: #fbffd5;">[+ dvp_name +]</span> + Other[? if gnvp_formed : + <span style="color: #774ae2;">GNVP</span> ?] + <span style="color: #1027dc;">MNVP</span> + <span style="color: #706a65;">NSDAP</span>([+ hitler_right_coalition_per +]%)
view-if: hitler_right_coalition_per >= 45 and nsdap_per >= 10
choose-if: hitler_right_coalition_per >= 50
on-arrival: percil_gov  = 3; other_per_gov = 1; dvp_per_gov = 1; gnvp_per_gov = 1; dnvp_per_gov = 1; nsdap_per_gov = 1; workers_nsdap += 2; new_middle_nsdap += 2; old_middle_nsdap += 2; nsdap_per_mod += 10;

@coalition

Governing Arrangement:

Current Caversket Support: [+ custom_coalition_per +]%

**Coalition:** [? if sapd_per_coa = 1: <span style="color: #940000;">KPM</span> ?][? if asum_per_coa = 1: <span style="color: #dd5b00;">ASUM</span> ?] <span style="color: #dc0200;">**[+ spd_name +]**</span> [? if spm_per_coa = 1: <span style="color: #ff1919;">SPM</span> ?][? if fvp_per_coa = 1: <span style="color: #ddd500;">FVP</span> ?][? if gdsu_per_coa = 1: <span style="color: #48ba48;">GDSU</span> ?][? if blpm_per_coa = 1: <span style="color: #00e8ff;">BLPM</span> ?][? if ppu_per_coa = 1: <span style="color: #4b9fde;">PPU</span> ?][? if ldp_per_coa = 1: <span style="color: #caa58b;">[+ dvp_name +]</span> ?]

*Toleration:* [? if sapd_per_coa = 2: <span style="color: #940000;">KPM</span> ?][? if asum_per_coa = 2: <span style="color: #dd5b00;">ASUM</span> ?][? if spm_per_coa = 2: <span style="color: #ff1919;">SPM</span> ?][? if fvp_per_coa = 2: <span style="color: #ddd500;">FVP</span> ?][? if gdsu_per_coa = 2: <span style="color: #48ba48;">GDSU</span> ?][? if blpm_per_coa = 2: <span style="color: #00e8ff;">BLPM</span> ?][? if ppu_per_coa = 2: <span style="color: #4b9fde;">PPU</span> ?][? if ldp_per_coa = 2: <span style="color: #caa58b;">[+ dvp_name +]</span> ?]

Opposition: [? if sapd_per_coa = 0 and sapd_formed = 1: <span style="color: #940000;">KPM</span> ?][? if asum_per_coa = 0 and asum_formed = 1: <span style="color: #dd5b00;">ASUM</span> ?][? if spm_per_coa = 0 and spm_formed = 1: <span style="color: #ff1919;">SPM</span> ?][? if fvp_per_coa = 0: <span style="color: #ddd500;">FVP</span> ?][? if gdsu_per_coa = 0: <span style="color: #48ba48;">GDSU</span> ?][? if blpm_per_coa = 0 and blpm_formed = 1: <span style="color: #00e8ff;">BLPM</span> ?][? if ppu_per_coa = 0: <span style="color: #4b9fde;">PPU</span> ?][? if ldp_per_coa = 0: <span style="color: #caa58b;">[+ dvp_name +]</span> ?]

-@gdsu_gov: We should try a colaition with the <span style="color: #48ba48;">GDSU</span>.
-@gdsu_gov_drop: Maybe we can try to get <span style="color: #48ba48;">GDSU</span> toleration.
-@kpm_gov: We should try a colaition with the <span style="color: #940000;">KPM</span>.
-@kpm_gov_drop: Leave the <span style="color: #940000;">KPM</span> out of the coalition.
-@asum_gov: We should try a colaition with the <span style="color: #dd5b00;">ASUM</span>.
-@asum_gov_drop: Leave the <span style="color: #dd5b00;">ASUM</span> out of the coalition.
-@spm_gov: We should try a colaition with the <span style="color: #ff1919;">SPM</span>.
-@spm_gov_drop: Leave the <span style="color: #ff1919;">SPM</span> out of the coalition.
-@fvp_gov: We should try a colaition with the <span style="color: #ddd500;">FVP</span>.
-@fvp_gov_drop: Leave the <span style="color: #ddd500;">FVP</span> out of the coalition.
-@ppu_gov: We should try a colaition with the <span style="color: #4b9fde;">PPU</span>.
-@ppu_gov_drop: Leave the <span style="color: #4b9fde;">PPU</span> out of the coalition.
-@ldp_gov: We should try a colaition with the <span style="color: #caa58b;">[+ dvp_name +]</span>.
-@ldp_gov_drop: Leave the <span style="color: #caa58b;">[+ dvp_name +]</span> out of the coalition.
-@custom: We can try this arrnagment to work.
-@return: Return to the "normal" coalitions.

@return
go-to: coalition_menu

@kpm_gov
view-if: sapd_formed > 0 and sapd_per_coa = 0
choose-if: kpm_coa >= 50
on-arrival: sapd_per_coa = 1; custom_coalition_per += sapd_per; ldp_coa -= 20; blpm_coa -= 15; gdsu_coa -= 15; fvp_coa -= 10; ppu_coa -= 10; fvp_coa += 5 if fvp_path >= 1; gdsu_coa += 5 if gdsu_ideology >= 2; ppu_coa += 5 if ppu_path >= 1;
go-to: coalition

