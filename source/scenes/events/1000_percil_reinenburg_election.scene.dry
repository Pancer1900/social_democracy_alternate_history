Q.liberal_coalition_per = (Q.z_per + Q.ddp_per + Q.dvp_per + Q.ppu_per + Q.blpm_per).toFixed(1); 
Q.wide_liberal_coalition_per = (Q.z_per + Q.ddp_per + Q.dvp_per + Q.ppu_per + Q.other_per + Q.blpm_per).toFixed(1);
Q.center_right_coalition_per = (Q.z_per + Q.dvp_per + Q.other_per + Q.dnvp_per + Q.blpm_per + Q.gnvp_per + Q.ppu_per).toFixed(1);
