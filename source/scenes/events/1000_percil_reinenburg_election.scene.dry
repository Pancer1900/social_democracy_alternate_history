Q.ppu_per = (Q.minorieties_ppu * Q.minorieties * 5.0) + (Q.ppu_per_mod * 10);
Q.pnf_per = (Q.percil_radicalisation * 10) + (Q.pnf_per_mod * 10) + (Q.minorieties_ppu * Q.minorieties * 1.0);
             
Q.per_total = 0;

if (Q.spd_per) Q.per_total += Q.spd_per;
if (Q.asum_per) Q.per_total += Q.asum_per;
if (Q.spm_per) Q.per_total += Q.spm_per;
if (Q.sapd_per) Q.per_total += Q.sapd_per;
