unavailable-subtitle: [? if gdsu_coa < 75: We do not have good enough relations with the <span style="color: #48ba48;">GDSU</span>. ?][? if fvp_coa < 75: We do not have good enough relations with the <span style="color: #ddd500;">FVP</span>. ?][? if liberal_reconciliation < 12: The Liberal Parties do not trust us enough to enter into a goverment with us. ?]
on-arrival: spd_merf_gov = 1; mirfallen_gov = 1; local_spd = 1; spm_merf_gov = 1; ddp_merf_gov = 1; z_merf_gov = 1; ppu_merf_gov = 1; sapd_relation -= 2*kpm_modifier; dvp_relation += 1.5*ldp_modifier; z_relation += 1.5*gdsu_modifier; ppu_relation += 1.5; ddp_relation += 1.5*fvp_modifier; rural_z += 1; minorieties_ppu += 1; peasnts_z += 1; other_rural += 1; new_middle_ddp += 1.5; workers_spd += 2; new_middle_spd += 1.5; workers_spm += 1; vsp_merf_gov = 1;

@grand
view-if: grand_coalition_merf >= 50 and zeltbrin_plus_coalition_merf <= 50 and liberal_reconciliation >= 16 and center_right_coalition_merf <= 50
subtitle: <span style="color: #dc0200;">**[+ spd_name +]**</span> + <span style="color: #ff7b00;">VSP</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span> + <span style="color: #4a9fde;">PPU</span> + <span style="color: #caa58b;">[+ dvp_name +]</span> ([+ grand_coalition_merf +]%)
choose-if: grand_coalition_merf >= 50 and liberal_reconciliation >= 18 and (fvp_coa + gdsu_coa) >= 140 and ldp_coa >= 65 and ppu_coa >= 65 and ppu_coa >= 65 and other_coa >= 65
on-arrival: spd_merf_gov = 1; mirfallen_gov = 1; local_spd = 1; spm_merf_gov = 1; ddp_merf_gov = 1; z_merf_gov = 1; ppu_merf_gov = 1; other_merf_gov = 1; dvp_merf_gov = 1; sapd_relation -= 3*kpm_modifier; dvp_relation += 2*ldp_modifier; z_relation += 2*gdsu_modifier; ppu_relation += 2; ddp_relation += 2*fvp_modifier; liberal_unity += 2; old_middle_dvp += 1; rural_z += 1; minorieties_ppu += 1; peasnts_z += 1; new_middle_dvp += 1; other_rural += 1; new_middle_ddp += 1.5; workers_spd += 1.5; new_middle_spd += 1.5; workers_spm += 1;
unavailable-subtitle: [? if (fvp_coa + gdsu_coa) <= 140: We do not have good enough relations with the left Liberals. ?][? if ldp_coa < 75: The LDP, is unwilling to compromise at all. ?][? if liberal_reconciliation < 18: The Liberal Parties do not trust us enough to enter into a goverment with us. ?]

@lib
view-if: liberal_coalition_merf >= 45
subtitle: <span style="color: #ddd500;">FVP</span> + <span style="color: #48ba48;">GDSU</span> + <span style="color: #4b9fde;">PPU</span>[? if blpm_formed : + <span style="color: #00e8ff;">BLPM</span> ?] + <span style="color: #caa58b;">[+ dvp_name +]</span> ([+ liberal_coalition_merf +]%)
choose-if: liberal_coalition_merf >= 50 and liberal_unity >= 40
unavailable-subtitle: [? if liberal_unity <= 40: Liberals are too conflicted to form a coherent goverment ?]
