subtitle: <span style="color: #caa58b;">[+ dvp_name +]</span> + <span style="color: #1b7035;">LTP</span> + <span style="color: #3F7BC1;">MNVP</span> + <span style="color: #8c1a16;">MTP</span> + <span style="color: #706a65;">NSDAP</span> ([+ hitler_right_coalition_merf +]%)
