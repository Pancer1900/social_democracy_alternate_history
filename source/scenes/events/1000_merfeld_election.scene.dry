unavailable-subtitle: [? if liberal_unity <= 40: Liberals are too conflicted to form a coherent goverment ?]
on-arrival: mirfallen_gov = 2; ddp_merf_gov = 1; z_merf_gov = 1; ppu_merf_gov = 1; other_merf_gov = 1; dvp_merf_gov = 1; liberal_unity += 2; old_middle_dvp += 1; rural_z += 1; minorieties_ppu += 1; peasnts_z += 1; new_middle_dvp += 1; other_rural += 1; new_middle_ddp += 1.5; vsp_merf_gov = 1;

@cent_right
subtitle: <span style="color: #48b94a;">GDSU</span> + <span style="color: #caa58b;">[+ dvp_name +]</span> + <span style="color: #4a9fde;">LTP</span> + <span style="color: #3F7BC1;">MNVP</span> ([+ center_right_coalition_merf +]%)
view-if: center_right_coalition_merf >= 45
choose-if: center_right_coalition_merf >= 50 and (dnvp_path - gdsu_ideology + 2 - ldp_ideology) >= 0 and liberal_unity >= 30
unavailable-subtitle: [? if liberal_unity <= 30: Liberals are too conflicted to form a coherent goverment. ?][? if (dnvp_path - gdsu_ideology + 2 - ldp_ideology) < 0: Liberals are unwilling to compromise with the MNVP. ?]
on-arrival: mirfallen_gov = 3; z_merf_gov = 1; ppu_merf_gov = 1; other_merf_gov = 1; dvp_merf_gov = 1; gnvp_merf_gov = 1; dnvp_merf_gov = 1; old_middle_dvp += 1; rural_z += 1; peasnts_z += 1 ; rural_dnvp += 1; minorieties_ppu += 1; new_middle_dvp += 1; other_rural += 1;

@right
subtitle: [? if ldp_reform > 0 : <span style="color: #caa58b;">[+ dvp_name +]</span> + ?]<span style="color: #48b94a;">GDSU</span> + <span style="color: #1b7035;">LTP</span> + <span style="color: #3F7BC1;">MNVP</span> + <span style="color: #8c1a16;">MTP</span> ([+ agrarian_right_coalition +]%)
