@lib_whide
subtitle: <span style="color: #ff7b00;">VSP</span> + <span style="color: #caa58b;">[+ dvp_name +]</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span> + <span style="color: #4a9fde;">PPU</span> + <span style="color: #1b7035;">LTP</span> ([+ wide_liberal_coalition_merf +]%)
