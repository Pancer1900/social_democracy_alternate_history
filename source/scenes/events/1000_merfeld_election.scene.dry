Q.spd_merf = (Q.workers_spd * Q.workers * 0.6) + (Q.old_middle_spd * Q.old_middle * 0.8) + (Q.new_middle_spd * Q.new_middle * 0.8) + (Q.peasants_spd * Q.peasants * 1.4) + (Q.rural_spd * Q.rural * 1.2) + (Q.catholics_spd * Q.catholics * 1.2) + (Q.minorieties_spd * Q.minorieties * 0.9) + (Q.unemployed_spd * Q.unemployed * 0.7) + (Q.spd_merf_mod * 10);
Q.sapd_merf = (Q.workers_sapd * Q.workers * 0.6) + (Q.old_middle_sapd * Q.old_middle * 0.8) + (Q.new_middle_sapd * Q.new_middle * 0.8) + (Q.peasants_sapd * Q.peasants * 1.4) + (Q.rural_sapd * Q.rural * 1.2) + (Q.catholics_sapd * Q.catholics * 1.2) + (Q.minorieties_sapd * Q.minorieties * 0.9) + (Q.unemployed_sapd * Q.unemployed * 0.7) + (Q.sapd_merf_mod * 10);
Q.spm_merf = (Q.workers_spm * Q.workers * 0.6) + (Q.old_middle_spm * Q.old_middle * 0.8) + (Q.new_middle_spm * Q.new_middle * 0.8) + (Q.peasants_spm * Q.peasants * 1.4) + (Q.rural_spm * Q.rural * 1.2) + (Q.catholics_spm * Q.catholics * 1.2) + (Q.minorieties_spm * Q.minorieties * 0.9) + (Q.unemployed_spm * Q.unemployed * 0.7) + (Q.spm_merf_mod * 10);
Q.asum_merf = (Q.workers_asum * Q.workers * 0.6) + (Q.old_middle_asum * Q.old_middle * 0.8) + (Q.new_middle_asum * Q.new_middle * 0.8) + (Q.peasants_asum * Q.peasants * 1.4) + (Q.rural_asum * Q.rural * 1.2) + (Q.catholics_asum * Q.catholics * 1.2) + (Q.minorieties_asum * Q.minorieties * 0.9) + (Q.unemployed_asum * Q.unemployed * 0.7) + (Q.asum_merf_mod * 10);
Q.ddp_merf = (Q.workers_ddp * Q.workers * 0.6) + (Q.old_middle_ddp * Q.old_middle * 0.8) + (Q.new_middle_ddp * Q.new_middle * 0.8) + (Q.peasants_ddp * Q.peasants * 1.4) + (Q.rural_ddp * Q.rural * 1.2) + (Q.catholics_ddp * Q.catholics * 1.2) + (Q.minorieties_ddp * Q.minorieties * 0.9) + (Q.unemployed_ddp * Q.unemployed * 0.7) + (Q.ddp_merf_mod * 10);
Q.z_merf = (Q.workers_z * Q.workers * 0.6) + (Q.old_middle_z * Q.old_middle * 0.8) + (Q.new_middle_z * Q.new_middle * 0.8) + (Q.peasants_z * Q.peasants * 1.4) + (Q.rural_z * Q.rural * 1.2) + (Q.catholics_z * Q.catholics * 1.2) + (Q.minorieties_z * Q.minorieties * 0.9) + (Q.unemployed_z * Q.unemployed * 0.7) + (Q.z_merf_mod * 10);
Q.dvp_merf = (Q.workers_dvp * Q.workers * 0.6) + (Q.old_middle_dvp * Q.old_middle * 0.8) + (Q.new_middle_dvp * Q.new_middle * 0.8) + (Q.peasants_dvp * Q.peasants * 1.4) + (Q.rural_dvp * Q.rural * 1.2) + (Q.catholics_dvp * Q.catholics * 1.2) + (Q.minorieties_dvp * Q.minorieties * 0.9) + (Q.unemployed_dvp * Q.unemployed * 0.7) + (Q.dvp_merf_mod * 10);
Q.dnvp_merf = (Q.workers_dnvp * Q.workers * 0.6) + (Q.old_middle_dnvp * Q.old_middle * 0.8) + (Q.new_middle_dnvp * Q.new_middle * 0.8) + (Q.peasants_dnvp * Q.peasants * 1.4) + (Q.rural_dnvp * Q.rural * 1.2) + (Q.catholics_dvp * Q.catholics * 1.2) + (Q.minorieties_dnvp * Q.minorieties * 0.9) + (Q.unemployed_dnvp * Q.unemployed * 0.7) + (Q.dnvp_merf_mod * 10);
Q.nsdap_merf = (Q.workers_nsdap * Q.workers * 0.6) + (Q.old_middle_nsdap * Q.old_middle * 0.8) + (Q.new_middle_nsdap * Q.new_middle * 0.8) + (Q.peasants_nsdap * Q.peasants * 1.4) + (Q.rural_nsdap * Q.rural * 1.2) + (Q.catholics_nsdap * Q.catholics * 1.2) + (Q.minorieties_nsdap * Q.minorieties * 0.9) + (Q.unemployed_nsdap * Q.unemployed * 0.7) + (Q.nsdap_merf_mod * 10);
Q.ppu_merf = (Q.workers_ppu * Q.workers * 0.6) + (Q.old_middle_ppu * Q.old_middle * 0.8) + (Q.new_middle_ppu * Q.new_middle * 0.8) + (Q.peasants_ppu * Q.peasants * 1.4) + (Q.rural_ppu * Q.rural * 1.2) + (Q.catholics_ppu * Q.catholics * 1.2) + (Q.minorieties_ppu * Q.minorieties * 0.9) + (Q.unemployed_ppu * Q.unemployed * 0.7) + (Q.ppu_merf_mod * 10);
Q.gnvp_merf = (Q.workers_gnvp * Q.workers * 0.6) + (Q.old_middle_gnvp * Q.old_middle * 0.8) + (Q.new_middle_gnvp * Q.new_middle * 0.8) + (Q.peasants_gnvp * Q.peasants * 1.4) + (Q.rural_gnvp * Q.rural * 1.2) + (Q.catholics_gnvp * Q.catholics * 1.2) + (Q.minorieties_gnvp * Q.minorieties * 0.9) + (Q.unemployed_gnvp * Q.unemployed * 0.7) + (Q.gnvp_merf_mod * 10);
Q.blpm_merf = (Q.workers_blpm * Q.workers * 0.6) + (Q.old_middle_blpm * Q.old_middle * 0.8) + (Q.new_middle_blpm * Q.new_middle * 0.8) + (Q.peasants_blpm * Q.peasants * 1.4) + (Q.rural_blpm * Q.rural * 1.2) + (Q.catholics_blpm * Q.catholics * 1.2) + (Q.minorieties_blpm * Q.minorieties * 0.9) + (Q.unemployed_blpm * Q.unemployed * 0.7) + (Q.blpm_merf_mod * 10);

Q.mtu_merf = (Q.peasants_other * Q.peasants * 1.5) + (Q.rural_other * Q.rural * 1.5) + (Q.other_merf_mod * 10) + (Q.minorieties_other * Q.minorieties * 4);
Q.ltp_merf = (Q.peasants_other * Q.peasants * 3) + (Q.rural_other * Q.rural * 3) + (Q.other_merf_mod * 10) + (Q.workers_other * Q.workers * 0.6);
             
Q.mer_total = 0;

if (Q.spd_merf) Q.mer_total += Q.spd_merf;
if (Q.asum_merf) Q.mer_total += Q.asum_merf;
if (Q.spm_merf) Q.mer_total += Q.spm_merf;
if (Q.sapd_merf) Q.mer_total += Q.sapd_merf;
if (Q.ddp_merf) Q.mer_total += Q.ddp_merf;
if (Q.ppu_merf) Q.mer_total += Q.ppu_merf;
if (Q.z_merf) Q.mer_total += Q.z_merf;
if (Q.dvp_merf) Q.mer_total += Q.dvp_merf;
if (Q.dnvp_merf) Q.mer_total += Q.dnvp_merf;
if (Q.nsdap_merf) Q.mer_total += Q.nsdap_merf;
if (Q.gnvp_merf) Q.mer_total += Q.gnvp_merf;
if (Q.blpm_merf) Q.mer_total += Q.blpm_merf;
if (Q.mtu_merf) Q.mer_total += Q.mtu_merf;
if (Q.ltp_merf) Q.mer_total += Q.ltp_merf;

if (Q.mer_total > 0) {
    Q.spd_merf = (Q.spd_merf / Q.mer_total) * 100;
    Q.spm_merf = (Q.spm_merf / Q.mer_total) * 100;
    Q.sapd_merf = (Q.sapd_merf / Q.mer_total) * 100;
    Q.asum_merf = (Q.asum_merf / Q.mer_total) * 100;
    Q.ddp_merf = (Q.ddp_merf / Q.mer_total) * 100;
    Q.ppu_merf = (Q.ppu_merf / Q.mer_total) * 100;
    Q.z_merf = (Q.z_merf / Q.mer_total) * 100;
    Q.dvp_merf = (Q.dvp_merf / Q.mer_total) * 100;
    Q.dnvp_merf = (Q.dnvp_merf / Q.mer_total) * 100;
    Q.nsdap_merf = (Q.nsdap_merf / Q.mer_total) * 100;
    Q.gnvp_merf = (Q.gnvp_merf / Q.mer_total) * 100;
    Q.blpm_merf = (Q.blpm_merf / Q.mer_total) * 100;
    Q.mtu_merf = (Q.mtu_merf / Q.mer_total) * 100;
    Q.ltp_merf = (Q.ltp_merf / Q.mer_total) * 100;
}

Q.spd_merf = (Q.spd_merf != undefined ? parseFloat(Q.spd_merf.toFixed(1)) : 0);
Q.spm_merf = (Q.spm_merf != undefined ? parseFloat(Q.spm_merf.toFixed(1)) : 0);
Q.sapd_merf = (Q.sapd_merf != undefined ? parseFloat(Q.sapd_merf.toFixed(1)) : 0);
Q.asum_merf = (Q.asum_merf != undefined ? parseFloat(Q.asum_merf.toFixed(1)) : 0);
Q.ddp_merf = (Q.ddp_merf != undefined ? parseFloat(Q.ddp_merf.toFixed(1)) : 0);
Q.ppu_merf = (Q.ppu_merf != undefined ? parseFloat(Q.ppu_merf.toFixed(1)) : 0);
Q.z_merf = (Q.z_merf != undefined ? parseFloat(Q.z_merf.toFixed(1)) : 0);
Q.dvp_merf = (Q.dvp_merf != undefined ? parseFloat(Q.dvp_merf.toFixed(1)) : 0);
Q.dnvp_merf = (Q.dnvp_merf != undefined ? parseFloat(Q.dnvp_merf.toFixed(1)) : 0);
Q.nsdap_merf = (Q.nsdap_merf != undefined ? parseFloat(Q.nsdap_merf.toFixed(1)) : 0);
Q.gnvp_merf = (Q.gnvp_merf != undefined ? parseFloat(Q.gnvp_merf.toFixed(1)) : 0);
Q.blpm_merf = (Q.blpm_merf != undefined ? parseFloat(Q.blpm_merf.toFixed(1)) : 0);
Q.mtu_merf = (Q.mtu_merf != undefined ? parseFloat(Q.mtu_merf.toFixed(1)) : 0);
Q.ltp_merf = (Q.ltp_merf != undefined ? parseFloat(Q.ltp_merf.toFixed(1)) : 0);

Q.mer_change_spd = Q.spd_merf - Q.spd_merf_old;
Q.mer_change_sapd = Q.sapd_merf - Q.sapd_merf_old;
Q.mer_change_spm = Q.spm_merf - Q.spm_merf_old;
Q.mer_change_asum = Q.asum_merf - Q.asum_merf_old;
Q.mer_change_ddp = Q.ddp_merf - Q.ddp_merf_old;
Q.mer_change_z = Q.z_merf - Q.z_merf_old;
Q.mer_change_blpm = Q.blpm_merf - Q.blpm_merf_old;
Q.mer_change_ppu = Q.ppu_merf - Q.ppu_merf_old;
Q.mer_change_dvp = Q.dvp_merf - Q.dvp_merf_old;
Q.mer_change_dnvp = Q.dnvp_merf - Q.dnvp_merf_old;
Q.mer_change_nsdap = Q.nsdap_merf - Q.nsdap_merf_old;
Q.mer_change_mtu = Q.mtu_merf - Q.mtu_merf_old;
Q.mer_change_ltp = Q.ltp_merf - Q.ltp_merf_old;
Q.mer_change_gnvp = Q.gnvp_merf - Q.gnvp_merf_old;

Q.left_coalition_merf = (Q.spd_merf + Q.sapd_merf + Q.spm_merf + Q.asum_merf).toFixed(1);
Q.progressive_coalition_merf = (Q.spd_merf + Q.sapd_merf + Q.spm_merf + Q.asum_merf + Q.ddp_merf).toFixed(1);
Q.popular_front_coalition_merf = (Q.spd_merf + Q.sapd_merf + Q.spm_merf + Q.asum_merf + Q.z_merf + Q.ddp_merf).toFixed(1);
Q.weimar_coalition_merf = (Q.spd_merf + Q.ddp_merf + Q.z_merf + Q.spm_merf).toFixed(1);
Q.zeltbrin_plus_coalition_merf = (Q.spd_merf + Q.ddp_merf + Q.z_merf + Q.blpm_merf + Q.ppu_merf + Q.spm_merf).toFixed(1);
Q.grand_coalition_merf = (Q.spd_merf + Q.spm_merf + Q.ddp_merf + Q.z_merf + Q.ppu_merf + Q.dvp_merf + Q.blpm_merf).toFixed(1);

Q.liberal_coalition_merf = (Q.z_merf + Q.ddp_merf + Q.dvp_merf + Q.ppu_merf + Q.blpm_merf).toFixed(1); 
Q.wide_liberal_coalition_merf = (Q.z_merf + Q.ddp_merf + Q.dvp_merf + Q.ppu_merf + Q.other_merf + Q.blpm_merf).toFixed(1);
Q.center_right_coalition_merf = (Q.z_merf + Q.dvp_merf + Q.other_merf + Q.dnvp_merf + Q.blpm_merf + Q.gnvp_merf + Q.ppu_merf).toFixed(1);
Q.right_coalition_merf = (Q.dvp_merf + Q.other_merf + Q.dnvp_merf + Q.gnvp_merf).toFixed(1);
Q.far_right_coalition_merf = (Q.dnvp_merf + Q.nsdap_merf + Q.gnvp_merf).toFixed(1);
Q.anti_democratic_coalition_merf = (Q.sapd_merf + Q.nsdap_merf + Q.dnvp_merf + Q.gnvp_merf).toFixed(1);
Q.hitler_right_coalition_merf = (Q.dnvp_merf + Q.nsdap_merf + Q.dvp_merf + Q.other_merf + Q.gnvp_merf).toFixed(1);

Q.mer_change_spd = (Q.mer_change_spd != undefined ? parseFloat(Q.mer_change_spd.toFixed(1)) : 0);
Q.mer_change_spm = (Q.mer_change_spm != undefined ? parseFloat(Q.mer_change_spm.toFixed(1)) : 0);
