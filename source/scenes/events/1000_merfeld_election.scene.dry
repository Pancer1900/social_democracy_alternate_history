        "legend": "MTU",
        "name": "MTU",
        "seats": Math.round(Q.mtu_merf*1),
    },
    {
        "id": "nsdap",
        "legend": "NSDAP",
        "name": "NSDAP",
        "seats": Math.round(Q.nsdap_merf*1),
    },
]);


if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("saxony_landtag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#saxony_landtag").datum(data).call(parliament);
}
!}
go-to: coalition_menu

**Merfeld Caversket:**

{!<svg id="saxony_landtag" style="width: 500px; height: 250px;"> </svg>!}

{!<table>!} 
{!<tr><td>Party</td><td>Vote share</td><td>% Change</td></tr>!}
{!<tr><td><div class="box" style='background-color:#dc0100; outline: 2px; outline-style: solid;'> </div> !} **[+ spd_name +]:** {!</td><td>!} **[+ spd_merf +]%** {!</td><td>!} **[+ mer_change_spd +]** {!</td></tr>!}

[? if sapd_formed : {!<tr><td><div class="box" style='background-color:#920002'> </div> !}KPM: {!</td><td>!} [+ sapd_merf +]% {!</td><td>!} [+ mer_change_sapd +] {!</td></tr>!} ?]

[? if asum_formed : {!<tr><td><div class="box" style='background-color:#dd5b00'> </div> !}ASUM: {!</td><td>!} [+ asum_merf +]% {!</td><td>!} [+ mer_change_asum +] {!</td></tr>!} ?]

[? if spm_formed : {!<tr><td><div class="box" style='background-color:#dc0200'> </div> !}SPM: {!</td><td>!} [+ spm_merf +]% {!</td><td>!} [+ mer_change_spm +] {!</td></tr>!} ?]

{!<tr><td><div class="box" style='background-color:#ff7b00'> </div> !} VSP: {!</td><td>!} [+ svp_merf +]% {!</td><td>!} [+ merf_change_svp +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#ddd500'> </div> !} [+ ddp_name +]: {!</td><td>!} [+ ddp_merf +]% {!</td><td>!} [+ mer_change_ddp +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#48b94a'> </div> !} GDSU: {!</td><td>!} [+ z_merf +]% {!</td><td>!} [+ mer_change_z +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#4b9ee0'> </div> !} PPU+: {!</td><td>!} [+ ppu_merf +]% {!</td><td>!} [+ mer_change_ppu +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#caa58b'> </div> !} [+ dvp_name +]: {!</td><td>!} [+ dvp_merf +]% {!</td><td>!} [+ mer_change_dvp +] {!</td></tr>!}
 
{!<tr><td><div class="box" style='background-color:#1b7035'> </div> !} LTP: {!</td><td>!} [+ ltp_merf +] % {!</td><td>!} [+ mer_change_ltp +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#1125e0'> </div> !} MNVP: {!</td><td>!} [+ dnvp_merf +]% {!</td><td>!} [+ mer_change_dnvp +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#8c1a16'> </div> !} MTP: {!</td><td>!} [+ mtu_merf +] % {!</td><td>!} [+ mer_change_mtu +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#706a65'> </div> !} NSDAP: {!</td><td>!} [+ nsdap_merf +]% {!</td><td>!} [+ mer_change_nsdap +] {!</td></tr>!}
{!</table>!}

**Potential coalitions:**

Zeltbrin Coalition (<span style="color: #dc0200;">**[+ spd_name +]**</span> + <span style="color: #ff7b00;">VSP</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span>): [+ weimar_coalition_merf +]%

[? if weimar_coalition_merf < 50 and liberal_reconciliation >= 16: Grand Coalition (<span style="color: #dc0200;">**[+ spd_name +]**</span> + <span style="color: #ff7b00;">VSP</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span> + <span style="color: #4a9fde;">PPU</span> + <span style="color: #caa58b;">[+ dvp_name +]</span>): [+ grand_coalition_merf +]% ?]

Liberal Coalition (<span style="color: #caa58b;">[+ dvp_name +]</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span> + <span style="color: #4a9fde;">PPU</span>): [+ liberal_coalition_merf +]%

[? if liberal_coalition_merf < 50 : Wide - Liberal Coalition (<span style="color: #ff7b00;">VSP</span> + <span style="color: #caa58b;">[+ dvp_name +]</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span> + <span style="color: #4a9fde;">PPU</span> + <span style="color: #1b7035;">LTP</span>): [+ wide_liberal_coalition_merf +]% ?]

Center-Right Coalition (<span style="color: #48b94a;">GDSU</span> + <span style="color: #caa58b;">LDP</span> + <span style="color: #4a9fde;">LTP</span> + <span style="color: #3F7BC1;">MNVP</span>): [+ center_right_coalition_merf +]%

Right-Agrarian Coalition ([? if ldp_reform > 0 : <span style="color: #caa58b;">[+ dvp_name +]</span> + ?]<span style="color: #48b94a;">GDSU</span> + <span style="color: #1b7035;">LTP</span> + <span style="color: #3F7BC1;">MNVP</span> + <span style="color: #8c1a16;">MTP</span>): [+ agrarian_right_coalition +]%

Right-wing Coalition (<span style="color: #caa58b;">[+ dvp_name +]</span> + <span style="color: #1b7035;">LTP</span> + <span style="color: #3F7BC1;">MNVP</span> + <span style="color: #8c1a16;">MTP</span> + <span style="color: #706a65;">NSDAP</span>): [+ hitler_right_coalition_merf +]%

[? if anti_democratic_coalition >= 50 : Together, the anti-democratic KPD, DNVP, and NSDAP have a majority in the Reichstag. A stable governing majority will be almost impossible. ?]

There are some potential coalition arrangements.

@coalition_menu

-@spd: We achived a <span style="color: #dc0200;">**[+ spd_name +]**</span> majority!
-@left: We achived a <span style="color: #d61818;">Socialist</span> majority of all the left wing patries!
-@prog_fro: We can atempth to form a <span style="color: #d61818;">Progr</span><span style="color: #ddd500;">esive</span> front with the <span style="color: #ddd500;">FVP</span> and other leftists parties.
-@popu: We can try to form the Popular Front bettwen the <span style="color: #48b94a;">GDSU</span>,<span style="color: #ddd500;">FVP</span> and other leftists parties.
-@prog: We can atempth to form a <span style="color: #d61818;">Progr</span><span style="color: #ddd500;">esive</span> Coalition with the <span style="color: #ddd500;">FVP</span>.
-@zelt: Zeltbrin coalition could be possible. 
-@grand: Maybe the we could try the reformist Grand coalition? 
-@lib: The Liberal coalition is formed. 
-@lib_whide: The liberals can form a wide coalition. 
-@cent_right: Center right coalition could form. 
-@right: A Agrarian-Right coalition could form.
-@far_right: A reactionary Right wing coalition could form.
-@no_majority: There is no possilbe majority. 
-@coalition: Maybe we can try some other coalition?

@no_majority
view-if: anti_democratic_coalition_merf >= 45
subtitle: This would mean the continuation of the current goverment with federal support and next election will be called in half of a year.
on-arrival: pro_republic -= 2; ddp_merf_gov = 1 if mirfallen_gov = 1; spd_merf_gov = 1 if mirfallen_gov = 1; spm_merf_gov = 1 if mirfallen_gov = 1; ddp_merf_gov = 1 if mirfallen_gov = 2; z_merf_gov = 1 if mirfallen_gov = 2; dvp_merf_gov = 1 if mirfallen_gov = 2; ppu_merf_gov = 1 if mirfallen_gov = 2; other_merf_gov = 1 if mirfallen_gov = 2; z_merf_gov = 1 if mirfallen_gov = 3; dvp_merf_gov = 1 if mirfallen_gov = 3; other_merf_gov = 1 if mirfallen_gov = 3; dnvp_merf_gov = 1 if mirfallen_gov = 3; ddp_merf_gov = 1 if mirfallen_gov = 2; nsdap_merf_mod += 25; sapd_merf_mod += 15;

@spd
view-if: spd_merf >= 50
on-arrival: spd_merf_gov = 1; mirfallen_gov = 1; local_spd = 1; workers_spd += 3; new_middle_spd += 2.5; rural_spd += 2; 

@left
subtitle: [+ spd_name +][? if sapd_formed : + <span style="color: #940000;">KPM</span> ?][? if asum_formed: + <span style="color: #dd5b00;">ASUM</span> ?][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?]([+ left_coalition_merf +]%)
view-if: left_coalition_merf >= 45 and (sapd_formed > 0 or spm_formed > 0)
choose-if: left_coalition_merf >= 50 and (kpm_coa + spm_coa) >= 130
unavailable-subtitle: [? if (kpm_coa + spm_coa) < 130: We do not have good enough relations with the other socialist parties. ?]
on-arrival: spd_merf_gov = 1; mirfallen_gov = 1; local_spd = 1; asum_merf_gov = 1; spm_merf_gov = 1; sapd_merf_gov = 1; liberal_unity += 3; sapd_relation += 3*kpm_modifier; dvp_relation -= 3*ldp_modifier; z_relation -= 2*gdsu_modifier; ppu_relation -= 1; ddp_relation -= 1; workers_spd += 2.5; new_middle_spd += 2; rural_spd += 1;  peasants_asum += 1.5; rural_asum += 1; workers_sapd += 2.5; workers_spm += 1; new_middle_spm += 1; vsp_merf_gov = 1;

@prog_fro
subtitle: [+ spd_name +][? if sapd_formed : + <span style="color: #940000;">KPM</span> ?][? if asum_formed: + <span style="color: #dd5b00;">ASUM</span> ?][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> ([+ progressive_front_merf +]%)
view-if: progressive_front_merf >= 45 and sapd_formed > 0
choose-if: progressive_front_merf >= 50 and (kpm_coa + spm_coa) >= 140 and ddp_coa >= 75 and liberal_reconciliation >= 10
unavailable-subtitle: [? if (kpm_coa + spm_coa) < 140: We do not have good enough relations with the other socialist parties. ?][? if ddp_coa < 75: We do not have good enough relations with the <span style="color: #ddd500;">FVP</span>. ?]
on-arrival: spd_merf_gov = 1; mirfallen_gov = 1; local_spd = 1; asum_merf_gov = 1; spm_merf_gov = 1; sapd_merf_gov = 1; ddp_merf_gov = 1; liberal_unity += 1; sapd_relation += 2*kpm_modifier; dvp_relation -= 2.5*ldp_modifier; z_relation -= 1.5*gdsu_modifier; ppu_relation -= 1;  ddp_relation += 1; new_middle_ddp += 2; new_middle_spd += 2; workers_spd += 2.5; workers_spm += 1; new_middle_spm += 1; workers_ddp += 1; peasants_asum += 1; rural_asum += 1; workers_sapd += 2;

@popu
subtitle: [+ spd_name +][? if sapd_formed : + <span style="color: #940000;">KPM</span> ?][? if asum_formed: + <span style="color: #dd5b00;">ASUM</span> ?][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> + <span style="color: #48ba48;">GDSU</span> ([+ popular_front_coalition_merf +]%)
view-if: popular_front_coalition_merf >= 45 and sapd_formed > 0
choose-if: popular_front_coalition_merf >= 50 and (kpm_coa + spm_coa) >= 150 and ddp_coa >= 80 and gdsu_coa >= 80 and liberal_reconciliation >= 18
unavailable-subtitle: [? if (kpm_coa + spm_coa) < 150: We do not have good enough relations with the other socialist parties. ?][? if gdsu_coa < 75: We do not have good enough relations with the <span style="color: #48ba48;">GDSU</span>. ?][? if fvp_coa < 75: We do not have good enough relations with the <span style="color: #ddd500;">FVP</span>. ?][? if liberal_reconciliation < 18: The Liberal Parties do not trust us enough to enter into a goverment with communists. ?]
on-arrival: spd_merf_gov = 1; mirfallen_gov = 1; local_spd = 1; asum_merf_gov = 1; spm_merf_gov = 1; sapd_merf_gov = 1; ddp_merf_gov = 1; z_merf_gov = 1; liberal_unity += 3; sapd_relation += 2*kpm_modifier; dvp_relation -= 3*ldp_modifier; z_relation -= 1*gdsu_modifier;  ddp_relation += 1; new_middle_ddp += 1; new_middle_spd += 2; workers_spd += 2; workers_spm += 1; new_middle_spm += 0.5; workers_ddp += 1; workers_z += 1; rural_z += 1; peasants_asum += 1; rural_asum += 0.5; workers_sapd += 2; vsp_merf_gov = 1;

@prog
subtitle: [+ spd_name +][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> ([+ progressive_coalition_merf +]%)
view-if: progressive_coalition_merf >= 45
choose-if: progressive_coalition_merf >= 50 and ddp_coa >= 70 and liberal_reconciliation >= 8
unavailable-subtitle: We do not have good enough relations with the <span style="color: #ddd500;">FVP</span> and they do not trust us enough.
on-arrival: spd_merf_gov = 1; mirfallen_gov = 1; local_spd = 1; spm_merf_gov = 1; ddp_merf_gov = 1; liberal_unity += 1; ddp_relation += 1; new_middle_ddp += 2; new_middle_spd += 2; workers_spd += 2.5; workers_spm += 1; new_middle_spm += 1; workers_ddp += 1;

@zelt
view-if: weimar_coalition_merf >= 45 and liberal_reconciliation >= 8
subtitle: [+ spd_name +][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> + <span style="color: #48ba48;">GDSU</span> ([+ weimar_coalition_merf +]%)
