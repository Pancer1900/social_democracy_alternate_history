@kpm_gov
view-if: sapd_formed > 0
choose-if: kpm_coa >= 50
on-arrival: sapd_r_coa = 1; custom_coalition_r += sapd_r; ldp_coa -= 20; blpm_coa -= 15; gdsu_coa -= 15; fvp_coa -= 10; ppu_coa -= 10; fvp_coa += 5 if fvp_path >= 1; gdsu_coa += 5 if gdsu_ideology >= 2; ppu_coa += 5 if ppu_path >= 1;
go-to: coalition

@kpm_tol
view-if: sapd_formed > 0
choose-if: kpm_coa >= 50
on-arrival: sapd_r_coa = 2; custom_coalition_r += sapd_r; ldp_coa -= 15; blpm_coa -= 11; gdsu_coa -= 11; fvp_coa -= 7; ppu_coa -= 7; fvp_coa += 3 if fvp_path >= 1; gdsu_coa += 3 if gdsu_ideology >= 2; ppu_coa += 3 if ppu_path >= 1;
go-to: coalition

@kpm_gov_drop
view-if: sapd_formed > 0 and sapd_r_coa = 1
on-arrival: sapd_r_coa = 0;  custom_coalition_r -= sapd_r; ldp_coa += 20; blpm_coa += 15; gdsu_coa += 15; fvp_coa += 10; ppu_coa += 10; fvp_coa -= 5 if fvp_path >= 1; gdsu_coa -= 5 if gdsu_ideology >= 2; ppu_coa -= 5 if ppu_path >= 1;
go-to: coalition

@kpm_tol_drop
view-if: sapd_formed > 0 and sapd_r_coa = 2
on-arrival: sapd_r_coa = 0; custom_coalition_r -= sapd_r; ldp_coa += 15; blpm_coa += 11; gdsu_coa += 11; fvp_coa += 7; ppu_coa += 7; fvp_coa -= 3 if fvp_path >= 1; gdsu_coa -= 3 if gdsu_ideology >= 2; ppu_coa -= 3 if ppu_path >= 1;
go-to: coalition

