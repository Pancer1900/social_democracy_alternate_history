on-display: {!
data = [];
if (Q.sapd_formed && Q.sapd_mir) {
    data.push({
            "id": "sapd",
            "legend": "KPM",
            "name": "KPM",
            "seats": Math.round(Q.sapd_mir*2),
            });
}
if (Q.asum_formed && Q.asum_mir) {
    data.push({
            "id": "asum",
            "legend": "ASUM",
            "name": "ASUM",
            "seats": Math.round(Q.asum_mir*2),
            });
}
data = data.concat([
    {
        "id": "spd",
        "legend": Q.spd_name,
        "name": Q.spd_name,
        "seats": Math.round(Q.spd_mir*2),
    },
    ]);
if (Q.spm_formed && Q.spm_mir) {
    data.push({
            "id": "spm",
            "legend": "SPM",
            "name": "SPM",
            "seats": Math.round(Q.spm_mir*2),
            });
}
data = data.concat([
    {
        "id": "vsp",
        "legend": "SVP",
        "name": "SVP",
        "seats": Math.round(Q.vsp_mir*2),
    },
    {
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Math.round(Q.ddp_mir*2),
    },
    {
        "id": "z",
        "legend": "GDSU",
        "name": "GDSU",
        "seats": Math.round(Q.z_mir*2),
    },
    {
        "id": "bvp",
        "legend": "PPU",
        "name": "PPU",
        "seats": Math.round(Q.ppu_mir*2),
    },
    {
        "id": "dvp",
        "legend": Q.dvp_name,
        "name": Q.dvp_name,
        "seats": Math.round(Q.dvp_mir*2),
    },
    {
        "id": "sud",
        "legend": "Other",
        "name": "Other",
        "seats": Math.round(Q.other_r*0.67),
    },
    {
        "id": "ltp",
        "legend": "ltp",
        "name": "ltp",
        "seats": Math.round(Q.other_r*0.67),
    },
    {
        "id": "other",
        "legend": "other",
        "name": "other",
        "seats": Math.round(Q.other_r*0.67),
    },

]);
if (Q.gnvp_formed && Q.gnvp_mir) {
    data.push({
            "id": "gnvp",
            "legend": "GNVP",
            "name": "GNVP",
            "seats": Math.round(Q.gnvp_mir*2),
            });
}
data = data.concat([
    {
        "id": "dnvp",
        "legend": "MNVP",
        "name": "MNVP",
        "seats": Math.round(Q.dnvp_mir*2),
    },
    {
        "id": "nsdap",
        "legend": "NSDAP",
        "name": "NSDAP",
        "seats": Math.round(Q.nsdap_mir*2),
    },
]);


if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("saxony_landtag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#saxony_landtag").datum(data).call(parliament);
}
!}
