    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("saxony_landtag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#saxony_landtag").datum(data).call(parliament);
}
!}
go-to: coalition_menu

**Mirfallen Caversket:**

{!<svg id="saxony_landtag" style="width: 500px; height: 250px;"> </svg>!}

{!<table>!} 
{!<tr><td>Party</td><td>Vote share</td><td>% Change</td></tr>!}
{!<tr><td><div class="box" style='background-color:#dc0100; outline: 2px; outline-style: solid;'> </div> !} **[+ spd_name +]:** {!</td><td>!} **[+ spd_mir +]%** {!</td><td>!} **[+ mer_change_spd +]** {!</td></tr>!}

[? if sapd_formed : {!<tr><td><div class="box" style='background-color:#920002'> </div> !}KPM: {!</td><td>!} [+ sapd_mir +]% {!</td><td>!} [+ mer_change_sapd +] {!</td></tr>!} ?]

[? if asum_formed : {!<tr><td><div class="box" style='background-color:#dd5b00'> </div> !}ASUM: {!</td><td>!} [+ asum_mir +]% {!</td><td>!} [+ mer_change_asum +] {!</td></tr>!} ?]

[? if spm_formed : {!<tr><td><div class="box" style='background-color:#dc0200'> </div> !}SPM: {!</td><td>!} [+ spm_mir +]% {!</td><td>!} [+ mir_change_spm +] {!</td></tr>!} ?]

{!<tr><td><div class="box" style='background-color:#ff7b00'> </div> !} VSP: {!</td><td>!} [+ vsp_mir +]% {!</td><td>!} [+ mer_change_vsp +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#ddd500'> </div> !} [+ ddp_name +]: {!</td><td>!} [+ ddp_mir +]% {!</td><td>!} [+ mer_change_ddp +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#48b94a'> </div> !} GDSU: {!</td><td>!} [+ z_mir +]% {!</td><td>!} [+ mer_change_z +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#4b9ee0'> </div> !} PPU+: {!</td><td>!} [+ ppu_mir +]% {!</td><td>!} [+ mer_change_ppu +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#caa58b'> </div> !} [+ dvp_name +]: {!</td><td>!} [+ dvp_mir +]% {!</td><td>!} [+ mer_change_dvp +] {!</td></tr>!}
 
{!<tr><td><div class="box" style='background-color:#dddddd'> </div> !} Others: {!</td><td>!} [+ other_mir +] % {!</td><td>!} [+ mer_change_other +] {!</td></tr>!}

[? if gnvp_formed : {!<tr><td><div class="box" style='background-color:#774ae2'> </div> !}GNVP: {!</td><td>!} [+ gnvp_mir +]% {!</td><td>!} [+ mer_change_gnvp +] {!</td></tr>!} ?]

{!<tr><td><div class="box" style='background-color:#1125e0'> </div> !} MNVP: {!</td><td>!} [+ dnvp_mir +]% {!</td><td>!} [+ mer_change_dnvp +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#706a65'> </div> !} NSDAP: {!</td><td>!} [+ nsdap_mir +]% {!</td><td>!} [+ mer_change_nsdap +] {!</td></tr>!}
{!</table>!}

**Potential coalitions:**

Zeltbrin Coalition (<span style="color: #dc0200;">**[+ spd_name +]**</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span>): [+ weimar_coalition_mir +]%

[? if weimar_coalition < 50 and liberal_reconciliation >= 10: Wide - Zeltbrin Coalition (<span style="color: #dc0200;">**[+ spd_name +]**</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span> + <span style="color: #4a9fde;">PPU</span>[? if blpm_formed = 1 : + <span style="color: #00e8ff;">BLPM</span> ?][? if vsp_lib = 1 : + <span style="color: #ff7b00;">VSP</span> ?]): [+ zeltbrin_plus_coalition_mir +]% ?]

Liberal Coalition (<span style="color: #caa58b;">LDP</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span> + <span style="color: #4a9fde;">PPU</span>): [+ liberal_coalition_mir +]%

[? if liberal_coalition < 50 : Wide - Liberal Coalition (<span style="color: #caa58b;">LDP</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span> + <span style="color: #4a9fde;">PPU</span> + others): [+ wide_liberal_coalition_mir +]% ?]

Center-Right Coalition (<span style="color: #48b94a;">GDSU</span> + <span style="color: #caa58b;">LDP</span> + <span style="color: #4a9fde;">PPU</span> + others + <span style="color: #3F7BC1;">MNVP</span> [? if gnvp_formed = 1 : + <span style="color: #774ae2;">GNVP</span>  ?][? if blpm_formed = 1 : + <span style="color: #00e8ff;">BLPM</span>  ?]): [+ center_right_coalition_mir +]%

Right-wing Coalition (<span style="color: #caa58b;">LDP</span> + others + <span style="color: #3F7BC1;">MNVP</span> [? if gnvp_formed = 1 : + <span style="color: #774ae2;">GNVP</span> ?]): [+ right_coalition_mir +]%

[? if anti_democratic_coalition >= 50 : Together, the anti-democratic KPD, DNVP, and NSDAP have a majority in the Reichstag. A stable governing majority will be almost impossible. ?]

There are some potential coalition arrangements.

@coalition_menu

-@spd: We achived a <span style="color: #dc0200;">**[+ spd_name +]**</span> majority!
-@left: We achived a <span style="color: #d61818;">Socialist</span> majority of all the left wing patries!
-@prog_fro: We can atempth to form a <span style="color: #d61818;">Progr</span><span style="color: #ddd500;">esive</span> front with the <span style="color: #ddd500;">FVP</span> and other leftists parties.
-@popu: We can try to form the Popular Front bettwen the <span style="color: #48b94a;">GDSU</span>,<span style="color: #ddd500;">FVP</span> and other leftists parties.
-@prog: We can atempth to form a <span style="color: #d61818;">Progr</span><span style="color: #ddd500;">esive</span> Coalition with the <span style="color: #ddd500;">FVP</span>.
-@zelt: Zeltbrin coalition could be possible. 
-@zelt_whide: We can try a wide Zeltbrin coalition. 
-@grand: Maybe the reactionary Grand coalition? 
-@lib: The Liberal coalition is formed. 
-@lib_whide: The liberals can form a wide coalition. 
-@cent_right: Center right coalition could form. 
-@right: A reactionary Right wing coalition could form.
-@far_right: This is the end....
-@no_majority: There is no possilbe majority. 
-@coalition: Maybe we can try some other coalition?

@no_majority
view-if: anti_democratic_coalition_mir >= 45
subtitle: This would mean the continuation of the current goverment with federal support and next election will be called in half of a year.
on-arrival: pro_republic -= 2; ddp_mir_gov = 1 if mirfallen_gov = 1; spd_mir_gov = 1 if mirfallen_gov = 1; spm_mir_gov = 1 if mirfallen_gov = 1; ddp_mir_gov = 1 if mirfallen_gov = 2; z_mir_gov = 1 if mirfallen_gov = 2; dvp_mir_gov = 1 if mirfallen_gov = 2; ppu_mir_gov = 1 if mirfallen_gov = 2; other_mir_gov = 1 if mirfallen_gov = 2; z_mir_gov = 1 if mirfallen_gov = 3; dvp_mir_gov = 1 if mirfallen_gov = 3; other_mir_gov = 1 if mirfallen_gov = 3; dnvp_mir_gov = 1 if mirfallen_gov = 3; ddp_mir_gov = 1 if mirfallen_gov = 2; nsdap_mir_mod += 25; sapd_mir_mod += 15;

@spd
view-if: spd_mir >= 50
on-arrival: spd_mir_gov = 1; mirfallen_gov = 1; local_spd = 1; workers_spd += 3; new_middle_spd += 2.5; rural_spd += 2; 

@left
subtitle: [+ spd_name +][? if sapd_formed : + <span style="color: #940000;">KPM</span> ?][? if asum_formed: + <span style="color: #dd5b00;">ASUM</span> ?][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?]([+ left_coalition_mir +]%)
view-if: left_coalition_mir >= 45 and (sapd_formed > 0 or spm_formed > 0)
choose-if: left_coalition_mir >= 50 and (kpm_coa + spm_coa) >= 130
unavailable-subtitle: [? if (kpm_coa + spm_coa) < 130: We do not have good enough relations with the other socialist parties. ?]
on-arrival: spd_mir_gov = 1; mirfallen_gov = 1; local_spd = 1; asum_mir_gov = 1; spm_mir_gov = 1; sapd_mir_gov = 1; liberal_unity += 3; sapd_relation += 3*kpm_modifier; dvp_relation -= 3*ldp_modifier; z_relation -= 2*gdsu_modifier; ppu_relation -= 1; ddp_relation -= 1; workers_spd += 2.5; new_middle_spd += 2; rural_spd += 1;  peasants_asum += 1.5; rural_asum += 1; workers_sapd += 2.5; workers_spm += 1; new_middle_spm += 1; vsp_mir_gov = 1;

@prog_fro
subtitle: [+ spd_name +][? if sapd_formed : + <span style="color: #940000;">KPM</span> ?][? if asum_formed: + <span style="color: #dd5b00;">ASUM</span> ?][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> ([+ progressive_front_mir +]%)
view-if: progressive_front_mir >= 45 and sapd_formed > 0
choose-if: progressive_front_mir >= 50 and (kpm_coa + spm_coa) >= 140 and ddp_coa >= 75 and liberal_reconciliation >= 10
unavailable-subtitle: [? if (kpm_coa + spm_coa) < 140: We do not have good enough relations with the other socialist parties. ?][? if ddp_coa < 75: We do not have good enough relations with the <span style="color: #ddd500;">FVP</span>. ?]
on-arrival: spd_mir_gov = 1; mirfallen_gov = 1; local_spd = 1; asum_mir_gov = 1; spm_mir_gov = 1; sapd_mir_gov = 1; ddp_mir_gov = 1; liberal_unity += 1; sapd_relation += 2*kpm_modifier; dvp_relation -= 2.5*ldp_modifier; z_relation -= 1.5*gdsu_modifier; ppu_relation -= 1;  ddp_relation += 1; new_middle_ddp += 2; new_middle_spd += 2; workers_spd += 2.5; workers_spm += 1; new_middle_spm += 1; workers_ddp += 1; peasants_asum += 1; rural_asum += 1; workers_sapd += 2;

@popu
subtitle: [+ spd_name +][? if sapd_formed : + <span style="color: #940000;">KPM</span> ?][? if asum_formed: + <span style="color: #dd5b00;">ASUM</span> ?][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> + <span style="color: #48ba48;">GDSU</span> ([+ popular_front_coalition_mir +]%)
view-if: popular_front_coalition_mir >= 45 and sapd_formed > 0
choose-if: popular_front_coalition_mir >= 50 and (kpm_coa + spm_coa) >= 150 and ddp_coa >= 80 and gdsu_coa >= 80 and liberal_reconciliation >= 18
unavailable-subtitle: [? if (kpm_coa + spm_coa) < 150: We do not have good enough relations with the other socialist parties. ?][? if gdsu_coa < 75: We do not have good enough relations with the <span style="color: #48ba48;">GDSU</span>. ?][? if fvp_coa < 75: We do not have good enough relations with the <span style="color: #ddd500;">FVP</span>. ?][? if liberal_reconciliation < 18: The Liberal Parties do not trust us enough to enter into a goverment with communists. ?]
on-arrival: spd_mir_gov = 1; mirfallen_gov = 1; local_spd = 1; asum_mir_gov = 1; spm_mir_gov = 1; sapd_mir_gov = 1; ddp_mir_gov = 1; z_mir_gov = 1; liberal_unity += 3; sapd_relation += 2*kpm_modifier; dvp_relation -= 3*ldp_modifier; z_relation -= 1*gdsu_modifier;  ddp_relation += 1; new_middle_ddp += 1; new_middle_spd += 2; workers_spd += 2; workers_spm += 1; new_middle_spm += 0.5; workers_ddp += 1; workers_z += 1; rural_z += 1; peasants_asum += 1; rural_asum += 0.5; workers_sapd += 2; vsp_mir_gov = 1;

@prog
subtitle: [+ spd_name +][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> ([+ progressive_coalition_mir +]%)
