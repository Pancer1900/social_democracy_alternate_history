@custom
choose-if: custom_coalition_r >= 50
on-arrival: {!

if(Q.ldp_r_coa > 0 && Q.ldp_coa <= 50)
{Q.failed = 1; Q.coa_tention += Q.ldp_coa - 50;}

if(Q.blpm_r_coa > 0 && Q.blpm_coa <= 50)
{Q.failed = 1; Q.coa_tention += Q.blpm_coa - 50;}

if(Q.sapd_r_coa > 0 && Q.kpm_coa <= 50)
{Q.failed = 1; Q.coa_tention += Q.kpm_coa - 50;}

if(Q.spm_r_coa > 0 && Q.spm_coa <= 50)
{Q.failed = 1; Q.coa_tention += Q.spm_coa - 50;}

if(Q.fvp_r_coa > 0 && Q.fvp_coa <= 50)
{Q.failed = 1; Q.coa_tention += Q.fvp_coa - 50;}

if(Q.gdsu_r_coa > 0 && Q.gdsu_coa <= 50)
{Q.failed = 1; Q.coa_tention += Q.gdsu_coa - 50;}

if(Q.ppu_r_coa > 0 && Q.ppu_coa <= 50)
{Q.failed = 1; Q.coa_tention += Q.ppu_coa - 50;}

if(Q.ldp_r_coa > 0 && Q.sapd_r_coa > 0)
{Q.failed = 1; Q.coa_tention += Q.ldp_coa; Q.coa_tention += Q.kpm_coa;}

!}
go-to: custom_sucess if failed = 0; custom_failed if failed > 1

@custom_sucess
on-arrival: {!

if(Q.ldp_r_coa > 0)
{Q.dvp_r_gov = 1; Q.old_middle_dvp += 1; Q.dvp_r_mod += 5; Q.dvp_relation += 2*Q.ldp_modifier;}

if(Q.blpm_r_coa > 0)
{Q.blpm_r_gov = 1; Q.new_middle_blpm += 1; Q.blpm_r_mod += 5;}

if(Q.sapd_r_coa > 0)
{Q.sapd_r_gov = 1; Q.workers_sapd += 1; Q.sapd_r_mod += 5; Q.sapd_relation += 2*Q.kpm_modifier}

if(Q.spm_r_coa > 0)
{Q.spm_r_gov = 1; Q.new_middle_spm += 1; Q.spm_r_mod += 5;}

if(Q.fvp_r_coa > 0)
{Q.ddp_r_gov = 1; Q.new_middle_ddp += 1; Q.ddp_r_mod += 5; Q.ddp_relation += 2*Q.fvp_modifer;}

if(Q.gdsu_r_coa > 0)
{Q.z_r_gov = 1; Q.rural_z += 1; Q.z_r_mod += 5; Q.z_relation += 2*Q.gdsu_modifer;}

if(Q.ppu_r_coa > 0)
{Q.ppu_r_gov = 1; Q.minorieties_ppu += 1; Q.ppu_r_mod += 5; Q.ppu_relation += 2;}

if(Q.asum_r_coa > 0)
{Q.asum_r_gov = 1; Q.peasants_asum += 1; Q.asum_r_mod += 5;}

Q.workers_spd += 2;

!}

Our Coalition planning succeded and we succesfully entered the goverment! 

@custom_failed
go-to: custom_try if coa_tention <= 15; custom_failed_2 if coa_tention > 15

