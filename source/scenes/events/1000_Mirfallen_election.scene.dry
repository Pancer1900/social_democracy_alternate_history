@zelt
view-if: weimar_coalition_mir >= 45 and liberal_reconciliation >= 8
subtitle: [+ spd_name +][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> + <span style="color: #48ba48;">GDSU</span> ([+ weimar_coalition_mir +]%)
