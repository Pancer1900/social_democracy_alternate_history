on-arrival: spd_mir_gov = 1; mirfallen_gov = 1; local_spd = 1; spm_mir_gov = 1; ddp_mir_gov = 1; z_mir_gov = 1; sapd_relation -= 1*kpm_modifier; dvp_relation += 1*ldp_modifier; z_relation += 1.5*gdsu_modifier; ddp_relation += 1.5*fvp_modifier; old_middle_dvp += 1; rural_z += 1; peasnts_z += 1; new_middle_ddp += 1.5; workers_spd += 2; new_middle_spd += 1.5; workers_spm += 1; vsp_mir_gov = 1;

@zelt_whide
view-if: zeltbrin_plus_coalition_mir >= 50 and weimar_coalition_mir <= 50 and liberal_reconciliation >= 8
subtitle: [+ spd_name +][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> + <span style="color: #48ba48;">GDSU</span> + <span style="color: #4b9fde;">PPU</span>[? if blpm_formed : + <span style="color: #00e8ff;">BLPM</span> ?]([+ weimar_coalition_mir +]%)
choose-if: zeltbrin_plus_coalition_mir >= 50 and ddp_coa >= 70 and gdsu_coa >= 70 and liberal_reconciliation >= 14 and ppu_coa >= 65
unavailable-subtitle: [? if gdsu_coa < 75: We do not have good enough relations with the <span style="color: #48ba48;">GDSU</span>. ?][? if fvp_coa < 75: We do not have good enough relations with the <span style="color: #ddd500;">FVP</span>. ?][? if liberal_reconciliation < 12: The Liberal Parties do not trust us enough to enter into a goverment with us. ?]
on-arrival: spd_mir_gov = 1; mirfallen_gov = 1; local_spd = 1; spm_mir_gov = 1; ddp_mir_gov = 1; z_mir_gov = 1; ppu_mir_gov = 1; sapd_relation -= 2*kpm_modifier; dvp_relation += 1.5*ldp_modifier; z_relation += 1.5*gdsu_modifier; ppu_relation += 1.5; ddp_relation += 1.5*fvp_modifier; rural_z += 1; minorieties_ppu += 1; peasnts_z += 1; other_rural += 1; new_middle_ddp += 1.5; workers_spd += 2; new_middle_spd += 1.5; workers_spm += 1; vsp_mir_gov = 1;

@grand
view-if: grand_coalition_mir >= 50 and zeltbrin_plus_coalition_mir <= 50 and liberal_reconciliation >= 16 and center_right_coalition_mir <= 50
subtitle: [+ spd_name +][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> + <span style="color: #48ba48;">GDSU</span> + <span style="color: #4b9fde;">PPU</span>[? if blpm_formed : + <span style="color: #00e8ff;">BLPM</span> ?] + <span style="color: #caa58b;">[+ dvp_name +]</span> + Other([+ grand_coalition_mir +]%)
choose-if: grand_coalition_mir >= 50 and liberal_reconciliation >= 18 and (fvp_coa + gdsu_coa) >= 140 and ldp_coa >= 65 and ppu_coa >= 65 and ppu_coa >= 65 and other_coa >= 65
on-arrival: spd_mir_gov = 1; mirfallen_gov = 1; local_spd = 1; spm_mir_gov = 1; ddp_mir_gov = 1; z_mir_gov = 1; ppu_mir_gov = 1; other_mir_gov = 1; dvp_mir_gov = 1; sapd_relation -= 3*kpm_modifier; dvp_relation += 2*ldp_modifier; z_relation += 2*gdsu_modifier; ppu_relation += 2; ddp_relation += 2*fvp_modifier; liberal_unity += 2; old_middle_dvp += 1; rural_z += 1; minorieties_ppu += 1; peasnts_z += 1; new_middle_dvp += 1; other_rural += 1; new_middle_ddp += 1.5; workers_spd += 1.5; new_middle_spd += 1.5; workers_spm += 1;
unavailable-subtitle: [? if (fvp_coa + gdsu_coa) <= 140: We do not have good enough relations with the left Liberals. ?][? if ldp_coa < 75: The LDP, is unwilling to compromise at all. ?][? if liberal_reconciliation < 18: The Liberal Parties do not trust us enough to enter into a goverment with us. ?]

@lib
view-if: liberal_coalition_mir >= 45
subtitle: <span style="color: #ddd500;">FVP</span> + <span style="color: #48ba48;">GDSU</span> + <span style="color: #4b9fde;">PPU</span>[? if blpm_formed : + <span style="color: #00e8ff;">BLPM</span> ?] + <span style="color: #caa58b;">[+ dvp_name +]</span> ([+ liberal_coalition_mir +]%)
choose-if: liberal_coalition_mir >= 50 and liberal_unity >= 40
unavailable-subtitle: [? if liberal_unity <= 40: Liberals are too conflicted to form a coherent goverment ?]
on-arrival: mirfallen_gov = 2; ddp_mir_gov = 1; z_mir_gov = 1; ppu_mir_gov = 1; dvp_mir_gov = 1; liberal_unity += 2.5; old_middle_dvp += 1; rural_z += 1; minorieties_ppu += 1; peasnts_z += 1; new_middle_dvp += 1; new_middle_ddp += 2;

@lib_whide
subtitle: <span style="color: #ddd500;">FVP</span> + <span style="color: #48ba48;">GDSU</span> + <span style="color: #4b9fde;">PPU</span>[? if blpm_formed : + <span style="color: #00e8ff;">BLPM</span> ?] + <span style="color: #caa58b;">[+ dvp_name +]</span> + Others ([+ wide_liberal_coalition_mir +]%) [? if vsp_lib = 1 : (This would mean the expanision of the liberal coalition with <span style="color: #ff7b00;">VSP</span>) ?]
view-if: wide_liberal_coalition_mir >= 50 and liberal_coalition_mir <= 50
choose-if: wide_liberal_coalition_mir >= 50 and liberal_unity >= 40
unavailable-subtitle: [? if liberal_unity <= 40: Liberals are too conflicted to form a coherent goverment ?]
on-arrival: mirfallen_gov = 2; ddp_mir_gov = 1; z_mir_gov = 1; ppu_mir_gov = 1; other_mir_gov = 1; dvp_mir_gov = 1; liberal_unity += 2; old_middle_dvp += 1; rural_z += 1; minorieties_ppu += 1; peasnts_z += 1; new_middle_dvp += 1; other_rural += 1; new_middle_ddp += 1.5; vsp_mir_gov = 1;

@cent_right
subtitle: <span style="color: #48ba48;">GDSU</span> + <span style="color: #4b9fde;">PPU</span>[? if blpm_formed : + <span style="color: #00e8ff;">BLPM</span> ?] + <span style="color: #caa58b;">[+ dvp_name +]</span> + Other[? if gnvp_formed : + <span style="color: #774ae2;">GNVP</span> ?] + <span style="color: #1027dc;">MNVP</span> ([+ center_right_coalition_mir +]%)
view-if: center_right_coalition_mir >= 45
choose-if: center_right_coalition_mir >= 50 and (dnvp_path - gdsu_ideology + 2 - ldp_ideology) >= 0 and liberal_unity >= 30 and liberal_right >= 30
unavailable-subtitle: [? if liberal_unity <= 30: Liberals are too conflicted to form a coherent goverment. ?][? if (dnvp_path - gdsu_ideology + 2 - ldp_ideology) < 0: Liberals are unwilling to compromise with the MNVP. ?]
on-arrival: mirfallen_gov = 3; z_mir_gov = 1; ppu_mir_gov = 1; other_mir_gov = 1; dvp_mir_gov = 1; gnvp_mir_gov = 1; dnvp_mir_gov = 1; old_middle_dvp += 1; rural_z += 1; peasnts_z += 1 ; rural_dnvp += 1; minorieties_ppu += 1; new_middle_dvp += 1; other_rural += 1;

@right
subtitle: <span style="color: #caa58b;">[+ dvp_name +]</span> + Other[? if gnvp_formed : + <span style="color: #774ae2;">GNVP</span> ?] + <span style="color: #1027dc;">MNVP</span> ([+ right_coalition_mir +]%)
view-if: right_coalition_mir >= 45
choose-if: right_coalition_mir >= 50
on-arrival: mirfallen_gov = 3; other_mir_gov = 1; dvp_mir_gov = 1; gnvp_mir_gov = 1; dnvp_mir_gov = 1; liberal_unity -= 2;

@far_right
subtitle: <span style="color: #fbffd5;">[+ dvp_name +]</span> + Other[? if gnvp_formed : + <span style="color: #774ae2;">GNVP</span> ?] + <span style="color: #1027dc;">MNVP</span> + <span style="color: #706a65;">NSDAP</span>([+ hitler_right_coalition_mir +]%)
