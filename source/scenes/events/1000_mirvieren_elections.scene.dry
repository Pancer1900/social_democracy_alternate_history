on-display: {!
data = [];
if (Q.sapd_formed && Q.sapd_mirv) {
    data.push({
            "id": "sapd",
            "legend": "KPM",
            "name": "KPM",
            "seats": Math.round(Q.sapd_mirv*1.5),
            });
}
if (Q.asum_formed && Q.asum_mirv) {
    data.push({
            "id": "asum",
            "legend": "ASUM",
            "name": "ASUM",
            "seats": Math.round(Q.asum_mirv*1.5),
            });
}
data = data.concat([
    {
        "id": "spd",
        "legend": Q.spd_name,
        "name": Q.spd_name,
        "seats": Math.round(Q.spd_mirv*1.5)
    },
    ]);
if (Q.spm_formed && Q.spm_mirv) {
    data.push({
            "id": "spm",
            "legend": "SPM",
            "name": "SPM",
            "seats": Math.round(Q.spm_mirv*1.5),
            });
}
data = data.concat([
    {
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Math.round(Q.ddp_mirv*1.5),
    },
    {
        "id": "bra",
        "legend": "PPB",
        "name": "PPB",
        "seats": Math.round(Q.bvp_mirv*1.5),
    },
    {
        "id": "z",
        "legend": "GDSU",
        "name": "GDSU",
        "seats": Math.round(Q.z_mirv*1.5),
    },
    ]);
if (Q.blpm_formed && Q.blpm_mirv) {
    data.push({
            "id": "blpm",
            "legend": "BLPM",
            "name": "BLPM",
            "seats": Math.round(Q.blpm_mirv*1.5),
            });
}
data = data.concat([
    {
        "id": "lac",
        "legend": "RNP",
        "name": "RNP",
        "seats": Math.round(Q.rnp_mirv*1.5),
    },
    {
        "id": "dvp",
        "legend": Q.dvp_name,
        "name": Q.dvp_name,
        "seats": Math.round(Q.dvp_mirv*1.5),
    },
    {
        "id": "ltp",
        "legend": "LTP",
        "name": "LTP",
        "seats": Math.round(Q.ltp_mirv*1.5),
    },

]);
if (Q.gnvp_formed && Q.gnvp_mirv) {
    data.push({
            "id": "gnvp",
            "legend": "GNVP",
            "name": "GNVP",
            "seats": Math.round(Q.gnvp_mirv*1.5),
            });
}
data = data.concat([
    {
        "id": "dnvp",
        "legend": "MNVP",
        "name": "MNVP",
        "seats": Math.round(Q.dnvp_mirv*1.5),
    },
    {
        "id": "sud",
        "legend": "MTU",
        "name": "MTU",
        "seats": Math.round(Q.mtu_mirv*1.5),
    },
    {
        "id": "nsdap",
        "legend": "NSDAP",
        "name": "NSDAP",
        "seats": Math.round(Q.nsdap_mirv*1.5),
    },
]);


if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("saxony_landtag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#saxony_landtag").datum(data).call(parliament);
}
!}

**Mirvieren Caversket:**

{!<svg id="saxony_landtag" style="width: 500px; height: 250px;"> </svg>!}

{!<table>!} 
{!<tr><td>Party</td><td>Vote share</td><td>% Change</td></tr>!}
