on-display: {!
data = [];
if (Q.sapd_formed && Q.sapd_mirv) {
    data.push({
            "id": "sapd",
            "legend": "KPM",
            "name": "KPM",
            "seats": Math.round(Q.sapd_mirv*1.5),
            });
}
if (Q.asum_formed && Q.asum_mirv) {
    data.push({
            "id": "asum",
            "legend": "ASUM",
            "name": "ASUM",
            "seats": Math.round(Q.asum_mirv*1.5),
            });
}
data = data.concat([
    {
        "id": "spd",
        "legend": Q.spd_name,
        "name": Q.spd_name,
        "seats": Math.round(Q.spd_mirv*1.5)
    },
    ]);
if (Q.spm_formed && Q.spm_mirv) {
    data.push({
            "id": "spm",
            "legend": "SPM",
            "name": "SPM",
            "seats": Math.round(Q.spm_mirv*1.5),
            });
}
data = data.concat([
    {
        "id": "bra",
        "legend": "PPB",
        "name": "PPB",
        "seats": Math.round(Q.bvp_mirv*1.5),
    },
    {
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Math.round(Q.ddp_mirv*1.5),
    },
    {
        "id": "z",
        "legend": "GDSU",
        "name": "GDSU",
        "seats": Math.round(Q.z_mirv*1.5),
    },
    ]);
data = data.concat([
    {
        "id": "lac",
        "legend": "RNP",
        "name": "RNP",
        "seats": Math.round(Q.rnp_mirv*1.5),
    },
    {
        "id": "dvp",
        "legend": Q.dvp_name,
        "name": Q.dvp_name,
        "seats": Math.round(Q.dvp_mirv*1.5),
    },
    {
        "id": "ltp",
        "legend": "LTP",
        "name": "LTP",
        "seats": Math.round(Q.ltp_mirv*1.5),
    },

]);
data = data.concat([
    {
        "id": "dnvp",
        "legend": "MNVP",
        "name": "MNVP",
        "seats": Math.round(Q.dnvp_mirv*1.5),
    },
    {
        "id": "sud",
        "legend": "MTU",
        "name": "MTU",
        "seats": Math.round(Q.mtu_mirv*1.5),
    },
    {
        "id": "nsdap",
        "legend": "NSDAP",
        "name": "NSDAP",
        "seats": Math.round(Q.nsdap_mirv*1.5),
    },
]);


if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("saxony_landtag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#saxony_landtag").datum(data).call(parliament);
}
!}
go-to: coalition_menu

**Mirvieren Caversket:**

{!<svg id="saxony_landtag" style="width: 500px; height: 250px;"> </svg>!}

{!<table>!} 
{!<tr><td>Party</td><td>Vote share</td><td>% Change</td></tr>!}
{!<tr><td><div class="box" style='background-color:#dc0100; outline: 2px; outline-style: solid;'> </div> !} **[+ spd_name +]:** {!</td><td>!} **[+ spd_mirv +]%** {!</td><td>!} **[+ mirv_change_spd +]** {!</td></tr>!}

[? if sapd_formed : {!<tr><td><div class="box" style='background-color:#920002'> </div> !}KPM: {!</td><td>!} [+ sapd_mirv +]% {!</td><td>!} [+ mirv_change_sapd +] {!</td></tr>!} ?]

[? if asum_formed : {!<tr><td><div class="box" style='background-color:#dd5b00'> </div> !}ASUM: {!</td><td>!} [+ asum_mirv +]% {!</td><td>!} [+ mirv_change_asum +] {!</td></tr>!} ?]

[? if spm_formed : {!<tr><td><div class="box" style='background-color:#dc0200'> </div> !}SPM: {!</td><td>!} [+ spm_mirv +]% {!</td><td>!} [+ mirv_change_spm +] {!</td></tr>!} ?]

{!<tr><td><div class="box" style='background-color:#993902'> </div> !} PPB: {!</td><td>!} [+ bvp_mirv +]% {!</td><td>!} [+ mirv_change_bvp +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#ddd500'> </div> !} [+ ddp_name +]: {!</td><td>!} [+ ddp_mirv +]% {!</td><td>!} [+ mirv_change_ddp +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#48b94a'> </div> !} GDSU: {!</td><td>!} [+ z_mirv +]% {!</td><td>!} [+ mirv_change_z +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#b0cf00'> </div> !} RNP: {!</td><td>!} [+ rnp_mirv +]% {!</td><td>!} [+ mirv_change_rnp +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#caa58b'> </div> !} [+ dvp_name +]: {!</td><td>!} [+ dvp_mirv +]% {!</td><td>!} [+ mirv_change_dvp +] {!</td></tr>!}
 
{!<tr><td><div class="box" style='background-color:#1b7035'> </div> !} LTP: {!</td><td>!} [+ ltp_mirv +] % {!</td><td>!} [+ mirv_change_ltp +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#1125e0'> </div> !} MNVP: {!</td><td>!} [+ dnvp_mirv +]% {!</td><td>!} [+ mirv_change_dnvp +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#8c1a16'> </div> !} MTP: {!</td><td>!} [+ mtu_mirv +] % {!</td><td>!} [+ mirv_change_mtu +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#706a65'> </div> !} NSDAP: {!</td><td>!} [+ nsdap_mirv +]% {!</td><td>!} [+ mirv_change_nsdap +] {!</td></tr>!}
{!</table>!}

**Potential coalitions:**

Zeltbrin Coalition (<span style="color: #dc0200;">**[+ spd_name +]**</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span> + <span style="color: #993902;">PPB</span> + <span style="color: #b0cf00;">RNP</span>): [+ zeltbrin_plus_coalition_mirv +]%

[? if zeltbrin_plus_coalition_mirv < 50 and liberal_reconciliation >= 16: Grand Coalition (<span style="color: #dc0200;">**[+ spd_name +]**</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span> + + <span style="color: #993902;">PPB</span> + <span style="color: #b0cf00;">RNP</span>): [+ grand_coalition_mirv +]% ?]

Liberal Coalition (<span style="color: #caa58b;">[+ dvp_name +]</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span> + <span style="color: #993902;">PPB</span> + <span style="color: #b0cf00;">RNP</span> + <span style="color: #1b7035;">LTP</span>): [+ liberal_coalition_mirv +]%

Center-Right Coalition (<span style="color: #48b94a;">GDSU</span> + <span style="color: #caa58b;">[+ dvp_name +]</span> + <span style="color: #1b7035;">LTP</span> + <span style="color: #3F7BC1;">MNVP</span> + <span style="color: #8c1a16;">MTP</span>): [+ center_right_coalition_mirv +]%

Right-wing Coalition (<span style="color: #caa58b;">[+ dvp_name +]</span> + <span style="color: #1b7035;">LTP</span> + <span style="color: #3F7BC1;">MNVP</span> + <span style="color: #8c1a16;">MTP</span> + <span style="color: #706a65;">NSDAP</span>): [+ right_coalition_mirv +]%

[? if anti_democratic_coalition >= 50 : Together, the anti-democratic KPD, DNVP, and NSDAP have a majority in the Reichstag. A stable governing majority will be almost impossible. ?]

There are some potential coalition arrangements.

@coalition_menu

-@spd: We achived a <span style="color: #dc0200;">**[+ spd_name +]**</span> majority!
-@left: We achived a <span style="color: #d61818;">Socialist</span> majority of all the left wing patries!
-@prog_fro: We can atempth to form a <span style="color: #d61818;">Progr</span><span style="color: #ddd500;">esive</span> front with the <span style="color: #ddd500;">FVP</span> and other leftists parties.
-@zelt_whide: We can try a wide Zeltbrin coalition with the minoriy paries. 
-@grand: Maybe the reactionary Grand coalition? 
-@lib_whide: The liberals can form a wide coalition. 
-@cent_right: Center right coalition could form. 
-@right: A reactionary Right wing coalition could form.
-@no_majority: There is no possilbe majority. 
-@coalition: Maybe we can try some other coalition?

@no_majority
view-if: anti_democratic_coalition_mirv >= 45 or (liberal_unity + liberal_right) < 80
subtitle: This would mean the continuation of the current goverment with federal support and next election will be called in half of a year.
on-arrival: pro_republic -= 2; ddp_mirv_gov = 1 if mirvieren_gov = 1; spd_mirv_gov = 1 if mirvieren_gov = 1; spm_mirv_gov = 1 if mirvieren_gov = 1; ddp_mirv_gov = 1 if mirvieren_gov = 2; z_mirv_gov = 1 if mirvieren_gov = 2; dvp_mirv_gov = 1 if mirvieren_gov = 2; ppu_mirv_gov = 1 if mirvieren_gov = 2; other_mirv_gov = 1 if mirvieren_gov = 2; z_mirv_gov = 1 if mirvieren_gov = 3; dvp_mirv_gov = 1 if mirvieren_gov = 3; other_mirv_gov = 1 if mirvieren_gov = 3; dnvp_mirv_gov = 1 if mirvieren_gov = 3; ddp_mirv_gov = 1 if mirvieren_gov = 2; nsdap_mirv_mod += 25; sapd_mirv_mod += 15;

@spd
view-if: spd_mirv >= 50
on-arrival: spd_mirv_gov = 1; mirvieren_gov = 1; local_spd = 1; workers_spd += 3; new_middle_spd += 2.5; rural_spd += 2; 

@left
subtitle: [+ spd_name +][? if sapd_formed : + <span style="color: #940000;">KPM</span> ?][? if asum_formed: + <span style="color: #dd5b00;">ASUM</span> ?][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?]([+ left_coalition_mirv +]%)
view-if: left_coalition_mirv >= 45 and (sapd_formed > 0 or spm_formed > 0)
choose-if: left_coalition_mirv >= 50 and (kpm_coa + spm_coa) >= 130
unavailable-subtitle: [? if (kpm_coa + spm_coa) < 130: We do not have good enough relations with the other socialist parties. ?]
on-arrival: spd_mirv_gov = 1; mirvieren_gov = 1; local_spd = 1; asum_mirv_gov = 1; spm_mirv_gov = 1; sapd_mirv_gov = 1; liberal_unity += 3; sapd_relation += 3*kpm_modifier; dvp_relation -= 3*ldp_modifier; z_relation -= 2*gdsu_modifier; ppu_relation -= 1; ddp_relation -= 1; workers_spd += 2.5; new_middle_spd += 2; rural_spd += 1;  peasants_asum += 1.5; rural_asum += 1; workers_sapd += 2.5; workers_spm += 1; new_middle_spm += 1;

@prog_fro
subtitle: [+ spd_name +][? if sapd_formed : + <span style="color: #940000;">KPM</span> ?][? if asum_formed: + <span style="color: #dd5b00;">ASUM</span> ?][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> + <span style="color: #993902;">PPB</span> ([+ progressive_front_mirv +]%)
view-if: progressive_coalition_mirv >= 45
choose-if: progressive_coalition_mirv >= 50 and (kpm_coa + spm_coa) >= 140 and ddp_coa >= 75 and liberal_reconciliation >= 10
unavailable-subtitle: [? if (kpm_coa + spm_coa) < 140: We do not have good enough relations with the other socialist parties. ?][? if ddp_coa < 75: We do not have good enough relations with the <span style="color: #ddd500;">FVP</span>. ?]
on-arrival: spd_mirv_gov = 1; mirvieren_gov = 1; local_spd = 1; asum_mirv_gov = 1; spm_mirv_gov = 1; sapd_mirv_gov = 1; ddp_mirv_gov = 1; liberal_unity += 1; sapd_relation += 2*kpm_modifier; dvp_relation -= 2.5*ldp_modifier; z_relation -= 1.5*gdsu_modifier; ppu_relation += 1; bvp_mirv_gov = 1; ddp_relation += 1; new_middle_ddp += 2; new_middle_spd += 2; workers_spd += 2.5; workers_spm += 1; new_middle_spm += 1; workers_ddp += 1; peasants_asum += 1; rural_asum += 1; workers_sapd += 2; minorieties_ppu += 1;

@zelt_whide
view-if: zeltbrin_plus_coalition_mirv >= 50 and liberal_reconciliation >= 8
subtitle: [+ spd_name +][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> + <span style="color: #48ba48;">GDSU</span> + <span style="color: #4b9fde;">ZET</span> + <span style="color: #993902;">PPB</span> + <span style="color: #b0cf00;">RNP</span> ([+ weimar_coalition_mirv +]%)
choose-if: zeltbrin_plus_coalition_mirv >= 50 and ddp_coa >= 70 and gdsu_coa >= 70 and liberal_reconciliation >= 14 and ppu_coa >= 65
unavailable-subtitle: [? if gdsu_coa < 75: We do not have good enough relations with the <span style="color: #48ba48;">GDSU</span>. ?][? if fvp_coa < 75: We do not have good enough relations with the <span style="color: #ddd500;">FVP</span>. ?][? if liberal_reconciliation < 12: The Liberal Parties do not trust us enough to enter into a goverment with us. ?]
on-arrival: spd_mirv_gov = 1; mirvieren_gov = 1; local_spd = 1; spm_mirv_gov = 1; ddp_mirv_gov = 1; z_mirv_gov = 1; ppu_mirv_gov = 1; sapd_relation -= 2*kpm_modifier; dvp_relation += 1.5*ldp_modifier; z_relation += 1.5*gdsu_modifier; ppu_relation += 1.5; ddp_relation += 1.5*fvp_modifier; rural_z += 1; minorieties_ppu += 1; peasnts_z += 1; other_rural += 1; new_middle_ddp += 1.5; workers_spd += 2; new_middle_spd += 1.5; workers_spm += 1; minorieties_ppu += 1; bvp_mirv_gov = 1;

@grand
view-if: grand_coalition_mirv >= 50 and zeltbrin_plus_coalition_mirv <= 50 and liberal_reconciliation >= 16 and center_right_coalition_mirv <= 50
subtitle: [+ spd_name +][? if spm_formed : + <span style="color: #ff1919;">SPM</span> ?] + <span style="color: #ddd500;">FVP</span> + <span style="color: #48ba48;">GDSU</span> + <span style="color: #993902;">PPB</span> + <span style="color: #b0cf00;">RNP</span> + <span style="color: #caa58b;">[+ dvp_name +]</span> ([+ grand_coalition_mirv +]%)
choose-if: grand_coalition_mirv >= 50 and liberal_reconciliation >= 18 and (fvp_coa + gdsu_coa) >= 140 and ldp_coa >= 65 and ppu_coa >= 65 and ppu_coa >= 65 and other_coa >= 65
on-arrival: spd_mirv_gov = 1; mirvieren_gov = 1; local_spd = 1; spm_mirv_gov = 1; ddp_mirv_gov = 1; z_mirv_gov = 1; ppu_mirv_gov = 1; bvp_mirv_gov = 1; dvp_mirv_gov = 1; sapd_relation -= 3*kpm_modifier; dvp_relation += 2*ldp_modifier; z_relation += 2*gdsu_modifier; ppu_relation += 2; ddp_relation += 2*fvp_modifier; liberal_unity += 2; old_middle_dvp += 1; rural_z += 1; minorieties_ppu += 1; peasnts_z += 1; new_middle_dvp += 1; other_rural += 1; new_middle_ddp += 1.5; workers_spd += 1.5; new_middle_spd += 1.5; workers_spm += 1; minorieties_ppu += 1;
unavailable-subtitle: [? if (fvp_coa + gdsu_coa) <= 140: We do not have good enough relations with the left Liberals. ?][? if ldp_coa < 75: The LDP, is unwilling to compromise at all. ?][? if liberal_reconciliation < 18: The Liberal Parties do not trust us enough to enter into a goverment with us. ?]

@lib_whide
subtitle: <span style="color: #caa58b;">LDP</span> + <span style="color: #48b94a;">GDSU</span> + <span style="color: #ddd500;">FVP</span> + <span style="color: #993902;">PPB</span> + <span style="color: #b0cf00;">RNP</span> + <span style="color: #1b7035;">LTP</span> ([+ liberal_coalition_mirv +]%)
view-if: liberal_coalition_mirv >= 50
choose-if: liberal_coalition_mirv >= 50 and liberal_unity >= 40
unavailable-subtitle: [? if liberal_unity <= 40: Liberals are too conflicted to form a coherent goverment ?]
on-arrival: mirvieren_gov = 2;  ltp_mirv_gov = 1; ddp_mirv_gov = 1; z_mirv_gov = 1; ppu_mirv_gov = 1; other_mirv_gov = 1; dvp_mirv_gov = 1; liberal_unity += 2; old_middle_dvp += 1; rural_z += 1; minorieties_ppu += 1; peasnts_z += 1; new_middle_dvp += 1; other_rural += 1; new_middle_ddp += 1.5; bvp_mirv_gov = 1; minorieties_ppu += 1;

@cent_right
subtitle: <span style="color: #48b94a;">GDSU</span> + <span style="color: #caa58b;">[+ dvp_name +]</span> + <span style="color: #1b7035;">LTP</span> + <span style="color: #3F7BC1;">MNVP</span> + <span style="color: #8c1a16;">MTP</span> ([+ center_right_coalition_mirv +]%)
view-if: center_right_coalition_mirv >= 45
choose-if: center_right_coalition_mirv >= 50 and (dnvp_path - gdsu_ideology + 2 - ldp_ideology) >= 0 and liberal_unity >= 30 and liberal_right >= 35
unavailable-subtitle: [? if liberal_unity <= 30: Liberals are too conflicted to form a coherent goverment. ?][? if (dnvp_path - gdsu_ideology + 2 - ldp_ideology) < 0: Liberals are unwilling to compromise with the MNVP. ?]
on-arrival: mirvieren_gov = 3; z_mirv_gov = 1; ltp_mirv_gov = 1; mtu_mirv_gov = 1; dvp_mirv_gov = 1; gnvp_mirv_gov = 1; dnvp_mirv_gov = 1; old_middle_dvp += 1; rural_z += 1; peasnts_z += 1 ; rural_dnvp += 1; new_middle_dvp += 1; other_rural += 2; liberal_right += 1;

@right
subtitle: <span style="color: #caa58b;">[+ dvp_name +]</span> + <span style="color: #1b7035;">LTP</span> + <span style="color: #3F7BC1;">MNVP</span> + <span style="color: #8c1a16;">MTP</span> + <span style="color: #706a65;">NSDAP</span> ([+ right_coalition_mirv +]%)
view-if: right_coalition_mirv >= 45
choose-if: right_coalition_mirv >= 50
on-arrival: mirvieren_gov = 3; mtu_mirv_gov = 1; dvp_mirv_gov = 1; gnvp_mirv_gov = 1; dnvp_mirv_gov = 1; liberal_unity -= 2; ltp_mirv_gov = 1;

@coalition

Governing Arrangement:

Current Caversket Support: [+ custom_coalition_mirv +]%

**Coalition:** [? if sapd_mirv_coa = 1: <span style="color: #940000;">KPM</span> ?][? if asum_mirv_coa = 1: <span style="color: #dd5b00;">ASUM</span> ?] <span style="color: #dc0200;">**[+ spd_name +]**</span> [? if spm_mirv_coa = 1: <span style="color: #ff1919;">SPM</span> ?][? if fvp_mirv_coa = 1: <span style="color: #ddd500;">FVP</span> ?][? if gdsu_mirv_coa = 1: <span style="color: #48ba48;">GDSU</span> ?][? if ppb_mirv_coa = 1: <span style="color: #993902;">PPB</span> ?][? if ppu_mirv_coa = 1: <span style="color: #b0cf00;">RNP</span> ?][? if ldp_mirv_coa = 1: <span style="color: #caa58b;">[+ dvp_name +]</span> ?]

Opposition: [? if sapd_mirv_coa = 0 and sapd_formed = 1: <span style="color: #940000;">KPM</span> ?][? if asum_mirv_coa = 0 and asum_formed = 1: <span style="color: #dd5b00;">ASUM</span> ?][? if spm_mirv_coa = 0 and spm_formed = 1: <span style="color: #ff1919;">SPM</span> ?][? if fvp_mirv_coa = 0: <span style="color: #ddd500;">FVP</span> ?][? if gdsu_mirv_coa = 0: <span style="color: #48ba48;">GDSU</span> ?][? if ppb_mirv_coa = 0: <span style="color: #993902;">PPB</span> ?][? if ppu_mirv_coa = 0: <span style="color: #b0cf00;">RNP</span> ?][? if ldp_mirv_coa = 0: <span style="color: #caa58b;">[+ dvp_name +]</span> ?]

-@kpm_gov: We should try a colaition with the <span style="color: #940000;">KPM</span>.
-@kpm_gov_drop: Leave the <span style="color: #940000;">KPM</span> out of the coalition.
-@asum_gov: We should try a colaition with the <span style="color: #dd5b00;">ASUM</span>.
-@asum_gov_drop: Leave the <span style="color: #dd5b00;">ASUM</span> out of the coalition.
-@spm_gov: We should try a colaition with the <span style="color: #ff1919;">SPM</span>.
-@spm_gov_drop: Leave the <span style="color: #ff1919;">SPM</span> out of the coalition.
-@fvp_gov: We should try a colaition with the <span style="color: #ddd500;">FVP</span>.
-@fvp_gov_drop: Leave the <span style="color: #ddd500;">FVP</span> out of the coalition.
-@gdsu_gov: We should try a colaition with the <span style="color: #48ba48;">GDSU</span>.
-@gdsu_gov_drop: Leave the <span style="color: #48ba48;">GDSU</span> out of the coalition.
-@blpm_gov: We should try a colaition with the <span style="color: #993902;">PPB</span>.
-@blpm_gov_drop: Leave the <span style="color: #993902;">PPB</span> out of the coalition.
-@ppu_gov: We should try a colaition with the <span style="color: #b0cf00;">RNP</span>.
-@ppu_gov_drop: Leave the <span style="color: #b0cf00;">RNP</span> out of the coalition.
-@ldp_gov: We should try a colaition with the <span style="color: #caa58b;">[+ dvp_name +]</span>.
-@ldp_gov_drop: Leave the <span style="color: #caa58b;">[+ dvp_name +]</span> out of the coalition.
-@custom: We can try this arrnagment to work.
-@return: Return to the "normal" coalitions.

@return
go-to: coalition_menu

@kpm_gov
view-if: sapd_formed > 0 and sapd_mirv_coa = 0
choose-if: kpm_coa >= 50
on-arrival: sapd_mirv_coa = 1; custom_coalition_mirv += sapd_mirv; ldp_coa -= 20; blpm_coa -= 15; gdsu_coa -= 15; fvp_coa -= 10; ppu_coa -= 10; fvp_coa += 5 if fvp_path >= 1; gdsu_coa += 5 if gdsu_ideology >= 2; ppu_coa += 5 if ppu_path >= 1;
go-to: coalition

@kpm_tol
view-if: sapd_formed > 0 and sapd_mirv_coa = 0
choose-if: kpm_coa >= 50
on-arrival: sapd_mirv_coa = 2; custom_coalition_mirv += sapd_mirv; ldp_coa -= 15; blpm_coa -= 11; gdsu_coa -= 11; fvp_coa -= 7; ppu_coa -= 7; fvp_coa += 3 if fvp_path >= 1; gdsu_coa += 3 if gdsu_ideology >= 2; ppu_coa += 3 if ppu_path >= 1;
go-to: coalition

@kpm_gov_drop
view-if: sapd_formed > 0 and sapd_mirv_coa = 1
on-arrival: sapd_mirv_coa = 0;  custom_coalition_mirv -= sapd_mirv; ldp_coa += 20; blpm_coa += 15; gdsu_coa += 15; fvp_coa += 10; ppu_coa += 10; fvp_coa -= 5 if fvp_path >= 1; gdsu_coa -= 5 if gdsu_ideology >= 2; ppu_coa -= 5 if ppu_path >= 1;
go-to: coalition

@kpm_tol_drop
view-if: sapd_formed > 0 and sapd_mirv_coa = 2
on-arrival: sapd_mirv_coa = 0; custom_coalition_mirv -= sapd_mirv; ldp_coa += 15; blpm_coa += 11; gdsu_coa += 11; fvp_coa += 7; ppu_coa += 7; fvp_coa -= 3 if fvp_path >= 1; gdsu_coa -= 3 if gdsu_ideology >= 2; ppu_coa -= 3 if ppu_path >= 1;
go-to: coalition

@asum_gov
view-if: asum_formed > 0 and asum_mirv_coa = 0
choose-if: (kpm_coa + spm_coa) >= 100
on-arrival: asum_mirv_coa = 1; custom_coalition_mirv += asum_mirv; ldp_coa -= 5; blpm_coa -= 4; gdsu_coa -= 3;
go-to: coalition

