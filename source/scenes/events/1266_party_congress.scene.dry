title: IV Plenary Party Congress
subtitle: Here we will decide the future of our party. 
tags: event
view-if: year = 1266 and month = 10 and pre_congress_seen = 1
priority: 2
max-visits: 1
new-page: true

= The IV plenary congress of the <span style="color: #dc0100;">**[+ spd_name +]**</span>. 

This is a moment that will decide the future of our party...

- @steats: May the delegates take their seats...

@steats
on-arrival: {!

if (Q.labor_strength < 0 && Q.unions_independent == 0 ) {
    Q.labor_strength = 4;
    }

if (Q.left_strength < 0 && Q.left_split == 0 ) {
    Q.left_strength = 4;
    }

if (Q.revolutionaries_strength < 0 && Q.revolutionaries_split == 0 ) {
    Q.revolutionaries_strength = 4;
    }

if (Q.reformist_strength < 0 && Q.reformists_resigned == 0 ) {
    Q.reformist_strength = 4;
    }

if (Q.agrarnians_strength < 0 && Q.agrarnians_split == 0 ) {
    Q.agrarnians_strength = 4;
    }

if (Q.center_strength < 0) {
    Q.center_strength = 4;
    }

Q.total_strength = Q.syn_strength + Q.left_strength + Q.center_strength + Q.labor_strength + Q.reformist_strength + Q.revolutionaries_strength + Q.agrarnians_strength;

Q.rev_seats = (Q.revolutionaries_strength/total_strength)*100;
Q.lef_seats = (Q.left_strength/total_strength)*100;
Q.agr_seats = (Q.agrarnians_strength/total_strength)*100;
Q.cen_seats = (Q.center_strength/total_strength)*100;
Q.lab_seats = (Q.labor_strength/total_strength)*100;
Q.ref_seats = (Q.reformist_strength/total_strength)*100;
Q.syn_seats = (Q.syn_strength/total_strength)*100;

Q.ref_seats = (Q.ref_seats != undefined ? parseFloat(Q.ref_seats.toFixed(1)) : 0);
Q.lab_seats = (Q.lab_seats != undefined ? parseFloat(Q.lab_seats.toFixed(1)) : 0);
Q.agr_seats = (Q.agr_seats != undefined ? parseFloat(Q.agr_seats.toFixed(1)) : 0);
Q.cen_seats = (Q.cen_seats != undefined ? parseFloat(Q.cen_seats.toFixed(1)) : 0);
Q.lab_seats = (Q.lab_seats != undefined ? parseFloat(Q.lab_seats.toFixed(1)) : 0);
Q.ref_seats = (Q.ref_seats != undefined ? parseFloat(Q.ref_seats.toFixed(1)) : 0);
Q.syn_seats = (Q.syn_seats != undefined ? parseFloat(Q.syn_seats.toFixed(1)) : 0);

!}
on-display: {!
data = [];
if (Q.revolutionaries_split == 0) {
    data.push({
            "id": "rev",
            "legend": "Revolutionaries",
            "name": "Revolutionaries",
            "seats": Math.round(Q.rev_seats*8),
            });
}
if (Q.left_split == 0) {
    data.push({
            "id": "lef",
            "legend": "Left",
            "name": "Left",
            "seats": Math.round(Q.lef_seats*8),
            });
}
if (Q.syn_created == 1) {
    data.push({
            "id": "syn",
            "legend": "Syndycalists",
            "name": "Syndycalists",
            "seats": Math.round(Q.syn_seats*8),
            });
}
if (Q.agrarnians_split == 0) {
    data.push({
            "id": "agr",
            "legend": "Agrariarins",
            "name": "Agrariarins",
            "seats": Math.round(Q.agr_seats*8),
            });
}
if (Q.centrists_resign == 0) {
    data.push({
            "id": "cen",
            "legend": "Centrists",
            "name": "Centrists",
            "seats": Math.round(Q.cen_seats*8),
            });
}
if (Q.unions_independent == 0) {
    data.push({
            "id": "lab",
            "legend": "Labour",
            "name": "Labour",
            "seats": Math.round(Q.lab_seats*8),
            });
}
if (Q.reformists_resigned == 0) {
    data.push({
            "id": "ref",
            "legend": "Reformist",
            "name": "Reformist",
            "seats": Math.round(Q.ref_seats*8),
            });
}

if (window && d3) {
    var width = 500; 
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50; 
        height = width;
        document.getElementById("reichstag").style.height = screenWidth/2 + "px";
    } 

    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#reichstag").datum(data).call(parliament);
}
!}

= Election results

{!<svg id="reichstag" style="width: 500px; height: 250px;"> </svg>!}

