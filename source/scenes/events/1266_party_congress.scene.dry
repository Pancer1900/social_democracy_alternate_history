@fight_right
choose-if: (rev_seats + lef_seats) < (ref_seats + cen_seats/2)
on-arrival: party_policy_paramilitary = 1; revolutionaries_dissent += 6; left_dissent += 4; agrarnians_dissent += 2; reformist_dissent -= 4;

fight_right

