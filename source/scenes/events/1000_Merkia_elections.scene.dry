Q.hitler_right_coalition_mer = (Q.dnvp_mer + Q.nsdap_mer + Q.dvp_mer + Q.other_mer + Q.gnvp_mer).toFixed(1);

Q.mer_change_spd = (Q.mer_change_spd != undefined ? parseFloat(Q.mer_change_spd.toFixed(1)) : 0);
