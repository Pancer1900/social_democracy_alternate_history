Q.mer_total = 0;

if (Q.spd_mer) Q.mer_total += Q.spd_mer;
if (Q.asum_mer) Q.mer_total += Q.asum_mer;
if (Q.spm_mer) Q.mer_total += Q.spm_mer;
if (Q.sapd_mer) Q.mer_total += Q.sapd_mer;
if (Q.ddp_mer) Q.mer_total += Q.ddp_mer;
if (Q.ppu_mer) Q.mer_total += Q.ppu_mer;
