Q.left_coalition_mer = (Q.spd_mer + Q.sapd_mer + Q.spm_mer + Q.asum_mer).toFixed(1);
Q.progressive_front_mer = (Q.spd_mer + Q.sapd_mer + Q.spm_mer + Q.asum_mer + Q.ddp_mer).toFixed(1);
