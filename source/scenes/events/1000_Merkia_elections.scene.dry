if (Q.gnvp_mer) Q.mer_total += Q.gnvp_mer;
if (Q.blpm_mer) Q.mer_total += Q.blpm_mer;

Q.kpm_coa = (Q.kpm_modifier*Q.sapd_relation) + 5;
Q.spm_coa = (Q.spm_modifier*Q.spm_relation) + 5;
Q.fvp_coa = (Q.fvp_modifier*Q.ddp_relation) + 5;
Q.gdsu_coa = (Q.gdsu_modifier*Q.z_relation) + 5;
Q.ppu_coa = (Q.ppu_relation) + 5;
Q.blpm_coa = (Q.fvp_modifier*Q.ldp_modifier*Q.dvp_relation) + 5;
Q.ldp_coa = (Q.ldp_modifier*Q.dvp_relation) + 5;
Q.other_coa = (Q.fvp_modifier*Q.ldp_modifier*Q.gdsu_modifier*50) + 5;

if (Q.spm_ally) {
    Q.spm_coa += 20;
    }
if (Q.kpm_ally) {
    Q.kpm_coa += 20;
    }
if (Q.ppu_ally) {
    Q.ppu_coa += 20;
    }
if (Q.fvp_ally) {
    Q.fvp_coa += 20;
    }

if (Q.sapd_formed == 0) {
    Q.fvp_coa -= 10;
    }
if (Q.sapd_formed == 0) {
    Q.gdsu_coa -= 20;
    }
if (Q.sapd_formed == 0) {
    Q.blpm_coa -= 20;
    }
if (Q.sapd_formed == 0) {
    Q.ldp_coa -= 30;
    }

if (Q.party_policy_fed == 2) {
    Q.ppu_coa += 10;
    }
if (Q.party_policy_fed == 2) {
    Q.other_coa += 10;
    }
if (Q.party_policy_fed == 0) {
    Q.ppu_coa -= 10;
    }

Q.fvp_coa -= Q.party_policy_main*2;
Q.gdsu_coa -= Q.party_policy_main*3;
Q.ldp_coa -= Q.party_policy_main*4;

Q.kpm_coa += Q.party_policy_main*2;
Q.spm_coa -= Q.party_policy_main;

Q.fvp_coa = 100;

if (Q.mer_total > 0) {
    Q.spd_mer = (Q.spd_mer / Q.mer_total) * 100;
    Q.spm_mer = (Q.spm_mer / Q.mer_total) * 100;
    Q.sapd_mer = (Q.sapd_mer / Q.mer_total) * 100;
    Q.asum_mer = (Q.asum_mer / Q.mer_total) * 100;
    Q.ddp_mer = (Q.ddp_mer / Q.mer_total) * 100;
    Q.ppu_mer = (Q.ppu_mer / Q.mer_total) * 100;
    Q.z_mer = (Q.z_mer / Q.mer_total) * 100;
    Q.dvp_mer = (Q.dvp_mer / Q.mer_total) * 100;
    Q.dnvp_mer = (Q.dnvp_mer / Q.mer_total) * 100;
