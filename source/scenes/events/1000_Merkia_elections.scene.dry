    Q.gnvp_mer = (Q.gnvp_mer / Q.mer_total) * 100;
    Q.blpm_mer = (Q.blpm_mer / Q.mer_total) * 100;
}

Q.spd_mer = (Q.spd_mer != undefined ? parseFloat(Q.spd_mer.toFixed(1)) : 0);
Q.spm_mer = (Q.spm_mer != undefined ? parseFloat(Q.spm_mer.toFixed(1)) : 0);
