[? if sapd_formed : {!<tr><td><div class="box" style='background-color:#920002'> </div> !}KPM: {!</td><td>!} [+ sapd_youg +]% {!</td><td>!} [+ youg_change_sapd +] {!</td></tr>!} ?]

