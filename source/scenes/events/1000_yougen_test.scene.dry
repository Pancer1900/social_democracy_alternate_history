Q.grand_coalition_youg = (Q.spd_youg + Q.spm_youg + Q.ddp_youg + Q.z_youg + Q.ppu_youg + Q.dvp_youg + Q.blpm_youg).toFixed(1);

Q.liberal_coalition_youg = (Q.z_youg + Q.ddp_youg + Q.dvp_youg + Q.ppu_youg + Q.blpm_youg).toFixed(1); 
Q.wide_liberal_coalition_youg = (Q.z_youg + Q.ddp_youg + Q.dvp_youg + Q.ppu_youg + Q.other_youg + Q.blpm_youg).toFixed(1);
Q.center_right_coalition_youg = (Q.z_youg + Q.dvp_youg + Q.other_youg + Q.dnvp_youg + Q.blpm_youg + Q.gnvp_youg + Q.ppu_youg).toFixed(1);
