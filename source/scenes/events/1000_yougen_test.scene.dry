Q.left_coalition_youg = (Q.spd_youg + Q.sapd_youg + Q.spm_youg + Q.asum_youg).toFixed(1);
Q.progressive_coalition_youg = (Q.spd_youg + Q.sapd_youg + Q.spm_youg + Q.asum_youg + Q.ddp_youg).toFixed(1);
Q.popular_front_coalition_youg = (Q.spd_youg + Q.sapd_youg + Q.spm_youg + Q.asum_youg + Q.z_youg + Q.ddp_youg).toFixed(1);
Q.weimar_coalition_youg = (Q.spd_youg + Q.ddp_youg + Q.z_youg + Q.spm_youg).toFixed(1);
