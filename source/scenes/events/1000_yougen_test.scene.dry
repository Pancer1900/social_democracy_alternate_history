{!<tr><td><div class="box" style='background-color:#48b94a'> </div> !} GDSU: {!</td><td>!} [+ z_youg +]% {!</td><td>!} [+ youg_change_z +] {!</td></tr>!}

[? if blpm_formed : {!<tr><td><div class="box" style='background-color:#00e8ff'> </div> !}BLPM: {!</td><td>!} [+ blpm_youg +]% {!</td><td>!} [+ youg_change_blpm +] {!</td></tr>!} ?]

