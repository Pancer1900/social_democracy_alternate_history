if (Q.blpm_youg) Q.youg_total += Q.blpm_youg;

if (Q.youg_total > 0) {
    Q.spd_youg = (Q.spd_youg / Q.youg_total) * 100;
    Q.spm_youg = (Q.spm_youg / Q.youg_total) * 100;
