    nsdap_mer: Q.nsdap_mer,
    gnvp_mer: Q.gnvp_mer,
    blpm_mer: Q.blpm_mer,
    other_mer: Q.other_mer
};

const allocatedSeats = allocateSeats(inputPercentages);

for (const party in allocatedSeats) {
    Q[party] = parseFloat(((allocatedSeats[party] * 100) / 200).toFixed(1));
}

Q.mer_change_spd = Q.spd_mer - Q.spd_mer_old;
