    Q.dnvp_mer = (Q.dnvp_mer / Q.total_r_saxony) * 100;
    Q.nsdap_mer = (Q.nsdap_mer / Q.total_r_saxony) * 100;
    Q.other_mer = (Q.other_mer / Q.total_r_saxony) * 100;
    Q.gnvp_mer = (Q.gnvp_mer / Q.total_r_saxony) * 100;
    Q.blpm_mer = (Q.blpm_mer / Q.total_r_saxony) * 100;
}

Q.spd_mer = (Q.spd_mer != undefined ? parseFloat(Q.spd_mer.toFixed(1)) : 0);
Q.spm_mer = (Q.spm_mer != undefined ? parseFloat(Q.spm_mer.toFixed(1)) : 0);
Q.sapd_mer = (Q.sapd_mer != undefined ? parseFloat(Q.sapd_mer.toFixed(1)) : 0);
Q.asum_mer = (Q.asum_mer != undefined ? parseFloat(Q.asum_mer.toFixed(1)) : 0);
Q.ddp_mer = (Q.ddp_mer != undefined ? parseFloat(Q.ddp_mer.toFixed(1)) : 0);
Q.ppu_mer = (Q.ppu_mer != undefined ? parseFloat(Q.ppu_mer.toFixed(1)) : 0);
Q.z_mer = (Q.z_mer != undefined ? parseFloat(Q.z_mer.toFixed(1)) : 0);
Q.dvp_mer = (Q.dvp_mer != undefined ? parseFloat(Q.dvp_mer.toFixed(1)) : 0);
Q.dnvp_mer = (Q.dnvp_mer != undefined ? parseFloat(Q.dnvp_mer.toFixed(1)) : 0);
Q.nsdap_mer = (Q.nsdap_mer != undefined ? parseFloat(Q.nsdap_mer.toFixed(1)) : 0);
Q.other_mer = (Q.other_mer != undefined ? parseFloat(Q.other_mer.toFixed(1)) : 0);
Q.gnvp_mer = (Q.gnvp_mer != undefined ? parseFloat(Q.gnvp_mer.toFixed(1)) : 0);
Q.blpm_mer = (Q.blpm_mer != undefined ? parseFloat(Q.blpm_mer.toFixed(1)) : 0);

Q.total_r_saxony = 0;

if (Q.spd_mer) Q.total_r_saxony += Q.spd_mer;
if (Q.asum_mer) Q.total_r_saxony += Q.asum_mer;
if (Q.spm_mer) Q.total_r_saxony += Q.spm_mer;
if (Q.sapd_mer) Q.total_r_saxony += Q.sapd_mer;
if (Q.ddp_mer) Q.total_r_saxony += Q.ddp_mer;
if (Q.ppu_mer) Q.total_r_saxony += Q.ppu_mer;
if (Q.z_mer) Q.total_r_saxony += Q.z_mer;
if (Q.dvp_mer) Q.total_r_saxony += Q.dvp_mer;
if (Q.dnvp_mer) Q.total_r_saxony += Q.dnvp_mer;
if (Q.nsdap_mer) Q.total_r_saxony += Q.nsdap_mer;
if (Q.other_mer) Q.total_r_saxony += Q.other_mer;
if (Q.gnvp_mer) Q.total_r_saxony += Q.gnvp_mer;
if (Q.blpm_mer) Q.total_r_saxony += Q.blpm_mer;

if (Q.total_r_saxony > 0) {
    Q.spd_mer = (Q.spd_mer / Q.total_r_saxony) * 100;
    Q.asum_mer = (Q.asum_mer / Q.total_r_saxony) * 100;
    Q.spm_mer = (Q.spm_mer / Q.total_r_saxony) * 100;
    Q.sapd_mer = (Q.sapd_mer / Q.total_r_saxony) * 100;
    Q.ddp_mer = (Q.ddp_mer / Q.total_r_saxony) * 100;
    Q.ppu_mer = (Q.ppu_mer / Q.total_r_saxony) * 100;
    Q.z_mer = (Q.z_mer / Q.total_r_saxony) * 100;
    Q.dvp_mer = (Q.dvp_mer / Q.total_r_saxony) * 100;
    Q.dnvp_mer = (Q.dnvp_mer / Q.total_r_saxony) * 100;
    Q.nsdap_mer = (Q.nsdap_mer / Q.total_r_saxony) * 100;
    Q.other_mer = (Q.other_mer / Q.total_r_saxony) * 100;
    Q.gnvp_mer = (Q.gnvp_mer / Q.total_r_saxony) * 100;
    Q.blpm_mer = (Q.blpm_mer / Q.total_r_saxony) * 100;
}

function allocateSeats(percentages, totalSeats = 200) {
    const exactSeats = {};
    const flooredSeats = {};
    const remainders = [];

    let totalFlooredSeats = 0;
    for (const party in percentages) {
        const exact = (percentages[party] * totalSeats) / 100;
        const floored = Math.floor(exact);
        const remainder = exact - floored;

        exactSeats[party] = exact;
        flooredSeats[party] = floored;
        totalFlooredSeats += floored;

        remainders.push({ party, remainder });
    }

    const seatsToDistribute = totalSeats - totalFlooredSeats;
    remainders.sort((a, b) => b.remainder - a.remainder);

    for (let i = 0; i < seatsToDistribute; i++) {
        flooredSeats[remainders[i].party]++;
    }

    return flooredSeats;
}

const inputPercentages = {
    spd_mer: Q.spd_mer,
    asum_mer: Q.asum_mer,
    spm_mer: Q.spm_mer,
    sapd_mer: Q.sapd_mer,
    ddp_mer: Q.ddp_mer,
    ppu_mer: Q.ppu_mer,
    z_mer: Q.z_mer,
    dvp_mer: Q.dvp_mer,
    dnvp_mer: Q.dnvp_mer,
    nsdap_mer: Q.nsdap_mer,
    gnvp_mer: Q.gnvp_mer,
    blpm_mer: Q.blpm_mer,
    other_mer: Q.other_mer
};

const allocatedSeats = allocateSeats(inputPercentages);

for (const party in allocatedSeats) {
    Q[party] = parseFloat(((allocatedSeats[party] * 100) / 200).toFixed(1));
}

Q.spd_mer = (Q.spd_mer != undefined ? parseFloat(Q.spd_mer.toFixed(1)) : 0);
Q.spm_mer = (Q.spm_mer != undefined ? parseFloat(Q.spm_mer.toFixed(1)) : 0);
Q.sapd_mer = (Q.sapd_mer != undefined ? parseFloat(Q.sapd_mer.toFixed(1)) : 0);
Q.ddp_mer = (Q.ddp_mer != undefined ? parseFloat(Q.ddp_mer.toFixed(1)) : 0);
Q.ppu_mer = (Q.ppu_mer != undefined ? parseFloat(Q.ppu_mer.toFixed(1)) : 0);
Q.z_mer = (Q.z_mer != undefined ? parseFloat(Q.z_mer.toFixed(1)) : 0);
Q.dvp_mer = (Q.dvp_mer != undefined ? parseFloat(Q.dvp_mer.toFixed(1)) : 0);
Q.dnvp_mer = (Q.dnvp_mer != undefined ? parseFloat(Q.dnvp_mer.toFixed(1)) : 0);
Q.nsdap_mer = (Q.nsdap_mer != undefined ? parseFloat(Q.nsdap_mer.toFixed(1)) : 0);
Q.other_mer = (Q.other_mer != undefined ? parseFloat(Q.other_mer.toFixed(1)) : 0);
Q.gnvp_mer = (Q.gnvp_mer != undefined ? parseFloat(Q.gnvp_mer.toFixed(1)) : 0);
Q.blpm_mer = (Q.blpm_mer != undefined ? parseFloat(Q.blpm_mer.toFixed(1)) : 0);
Q.asum_mer = (Q.asum_mer != undefined ? parseFloat(Q.asum_mer.toFixed(1)) : 0);

!}
on-display: {!
data = [];
if (Q.sapd_formed && Q.sapd_r) {
    data.push({
            "id": "sapd",
            "legend": "KPM",
            "name": "KPM",
            "seats": Math.round(Q.sapd_mer*0.96),
            });
}
if (Q.asum_formed && Q.asum_r) {
    data.push({
            "id": "asum",
            "legend": "ASUM",
            "name": "ASUM",
            "seats": Math.round(Q.asum_mer*0.96),
            });
}
data = data.concat([
    {
        "id": "spd",
        "legend": Q.spd_name,
        "name": Q.spd_name,
        "seats": Math.round(Q.spd_mer*0.96),
    },
    ]);
if (Q.spm_formed && Q.spm_r) {
    data.push({
            "id": "spm",
            "legend": "SPM",
            "name": "SPM",
            "seats": Math.round(Q.spm_mer*0.96),
            });
}
data = data.concat([
    {
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Math.round(Q.ddp_mer*0.96),
    },
    {
        "id": "z",
        "legend": "GDSU",
        "name": "GDSU",
        "seats": Math.round(Q.z_mer*0.96),
    },
    ]);
if (Q.blpm_formed && Q.blpm_r) {
    data.push({
            "id": "blpm",
            "legend": "BLPM",
            "name": "BLPM",
            "seats": Math.round(Q.blpm_mer*0.96),
            });
}
data = data.concat([
    {
        "id": "bvp",
        "legend": "PPU",
        "name": "PPU",
        "seats": Math.round(Q.ppu_mer*0.96),
    },
    {
        "id": "dvp",
        "legend": Q.dvp_name,
        "name": Q.dvp_name,
        "seats": Math.round(Q.dvp_mer*0.96),
    },
    {
        "id": "other",
        "legend": "Other",
        "name": "Other",
        "seats": Math.round(Q.other_mer*0.96),
    },
]);
if (Q.gnvp_formed && Q.gnvp_r) {
    data.push({
            "id": "gnvp",
            "legend": "GNVP",
            "name": "GNVP",
            "seats": Math.round(Q.gnvp_mer*0.96),
            });
}
data = data.concat([
    {
        "id": "dnvp",
        "legend": "MNVP",
        "name": "MNVP",
        "seats": Math.round(Q.dnvp_mer*0.96),
    },
    {
        "id": "nsdap",
        "legend": "NSDAP",
        "name": "NSDAP",
        "seats": Math.round(Q.nsdap_mer*0.96),
    },
]);


if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("saxony_landtag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#saxony_landtag").datum(data).call(parliament);
}
!}


