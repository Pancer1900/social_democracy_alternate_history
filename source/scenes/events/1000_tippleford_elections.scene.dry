view-if: gdsu_zel_coa = 1
on-arrival: asum_zel_coa = 0; custom_coalition_zel -= z_zel; kpm_coa -= 5 if gdsu_ideology >= 2; kpm_coa += 15;
go-to: coalition

@gdsu_tol_drop
