Q.sapd_zel = (Q.workers_sapd * Q.workers * 1.05) + (Q.old_middle_sapd * Q.old_middle * 1.1) + (Q.new_middle_sapd * Q.new_middle * 1.1) + (Q.peasants_sapd * Q.peasants * 0.9) + (Q.rural_sapd * Q.rural * 0.9) + (Q.catholics_sapd * Q.catholics * 0.8) + (Q.minorieties_sapd * Q.minorieties * 0.5) + (Q.unemployed_sapd * Q.unemployed * 0.9) + (Q.sapd_zel_mod * 10);
Q.spm_zel = (Q.workers_spm * Q.workers * 1.05) + (Q.old_middle_spm * Q.old_middle * 1.1) + (Q.new_middle_spm * Q.new_middle * 1.1) + (Q.peasants_spm * Q.peasants * 0.9) + (Q.rural_spm * Q.rural * 0.9) + (Q.catholics_spm * Q.catholics * 0.8) + (Q.minorieties_spm * Q.minorieties * 0.5) + (Q.unemployed_spm * Q.unemployed * 0.9) + (Q.spm_zel_mod * 10);
