Q.rnp_zel = (Q.peasants_ppu * Q.peasants * 2) + (Q.rural_ppu * Q.rural * 2) + (Q.ppu_zel_mod * 10) + (Q.workers_ppu * Q.workers * 1) + (Q.old_middle_blpm * Q.old_middle * 2) + (Q.new_middle_blpm * Q.new_middle * 2) + (Q.minorieties_ppu * Q.minorieties * 2);
Q.zek_zel = (Q.peasants_other * Q.peasants * 0.8) + (Q.rural_other * Q.rural * 0.8) + (Q.others_zel_mod * 10) + (Q.workers_other * Q.workers * 1) + (Q.old_middle_other * Q.old_middle * 1.5) + (Q.new_middle_blpm * Q.new_middle * 1.5);
Q.ltp_zel = (Q.peasants_other * Q.peasants * 1.2) + (Q.rural_other * Q.rural * 1.2) + (Q.others_zel_mod * 10) + (Q.workers_other * Q.workers * 0.5);

Q.zel_total = 0;

if (Q.spd_zel) Q.zel_total += Q.spd_zel;
if (Q.asum_zel) Q.zel_total += Q.asum_zel;
