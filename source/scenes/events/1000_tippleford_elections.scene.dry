if (Q.ltp_zel) Q.zel_total += Q.ltp_zel;
if (Q.rnp_zel) Q.zel_total += Q.rnp_zel;

if (Q.zel_total > 0) {
    Q.spd_zel = (Q.spd_zel / Q.zel_total) * 100;
    Q.spm_zel = (Q.spm_zel / Q.zel_total) * 100;
    Q.sapd_zel = (Q.sapd_zel / Q.zel_total) * 100;
    Q.asum_zel = (Q.asum_zel / Q.zel_total) * 100;
