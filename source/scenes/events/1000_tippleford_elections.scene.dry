Q.left_coalition_zel = (Q.spd_zel + Q.sapd_zel + Q.spm_zel + Q.asum_zel).toFixed(1);
Q.progressive_coalition_zel = (Q.spd_zel + Q.sapd_zel + Q.spm_zel + Q.asum_zel + Q.ddp_zel).toFixed(1);
