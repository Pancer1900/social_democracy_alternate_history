    Q.blpm_zel = (Q.blpm_zel / Q.zel_total) * 100;
    Q.zek_zel = (Q.zek_zel / Q.zel_total) * 100;
    Q.ltp_zel = (Q.ltp_zel / Q.zel_total) * 100;
    Q.rnp_zel = (Q.rnp_zel / Q.zel_total) * 100;
}

Q.spd_zel = (Q.spd_zel != undefined ? parseFloat(Q.spd_zel.toFixed(1)) : 0);
Q.spm_zel = (Q.spm_zel != undefined ? parseFloat(Q.spm_zel.toFixed(1)) : 0);
