Q.nsdap_zel = (Q.workers_nsdap * Q.workers * 1.05) + (Q.old_middle_nsdap * Q.old_middle * 1.1) + (Q.new_middle_nsdap * Q.new_middle * 1.1) + (Q.peasants_nsdap * Q.peasants * 0.9) + (Q.rural_nsdap * Q.rural * 0.9) + (Q.catholics_nsdap * Q.catholics * 0.8) + (Q.minorieties_nsdap * Q.minorieties * 0.5) + (Q.unemployed_nsdap * Q.unemployed * 0.9) + (Q.nsdap_zel_mod * 10);
