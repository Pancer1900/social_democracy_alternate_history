Q.grand_coalition_zel = (Q.spd_zel + Q.spm_zel + Q.ddp_zel + Q.z_zel + Q.ppu_zel + Q.dvp_zel + Q.blpm_zel).toFixed(1);

Q.liberal_coalition_zel = (Q.z_zel + Q.ddp_zel + Q.dvp_zel + Q.ppu_zel + Q.blpm_zel).toFixed(1); 
Q.wide_liberal_coalition_zel = (Q.z_zel + Q.ddp_zel + Q.dvp_zel + Q.other_zel + Q.ppu_zel + Q.blpm_zel).toFixed(1);
Q.center_right_coalition_zel = (Q.z_zel + Q.dvp_zel + Q.other_zel + Q.dnvp_zel + Q.blpm_zel + Q.gnvp_zel + Q.ppu_zel).toFixed(1);
