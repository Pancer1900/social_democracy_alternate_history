on-display: {!
data = [];
if (Q.sapd_formed && Q.sapd_zel) {
    data.push({
            "id": "sapd",
            "legend": "KPM",
            "name": "KPM",
            "seats": Math.round(Q.sapd_zel*1),
            });
}
if (Q.asum_formed && Q.asum_zel) {
    data.push({
            "id": "asum",
            "legend": "ASUM",
            "name": "ASUM",
            "seats": Math.round(Q.asum_zel*1),
            });
}
data = data.concat([
    {
        "id": "spd",
        "legend": Q.spd_name,
        "name": Q.spd_name,
        "seats": Math.round(Q.spd_zel*1)
    },
    ]);
if (Q.spm_formed && Q.spm_zel) {
    data.push({
            "id": "spm",
            "legend": "SPM",
            "name": "SPM",
            "seats": Math.round(Q.spm_zel*1),
            });
}
data = data.concat([
    {
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Math.round(Q.ddp_zel*1),
    },
    {
        "id": "lac",
        "legend": "LREP",
        "name": "LREP",
        "seats": Math.round(Q.rnp_zel*1),
    },
    {
        "id": "z",
        "legend": "GDSU",
        "name": "GDSU",
        "seats": Math.round(Q.z_zel*1),
    },
    ]);
data = data.concat([
    {
        "id": "znc",
        "legend": "ZEK",
        "name": "ZEK",
        "seats": Math.round(Q.zek_zel*1),
    },
    {
        "id": "dvp",
        "legend": Q.dvp_name,
        "name": Q.dvp_name,
        "seats": Math.round(Q.dvp_zel*1),
    },
    {
        "id": "ltp",
        "legend": "LTP",
        "name": "LTP",
        "seats": Math.round(Q.ltp_zel*1),
    },

]);
data = data.concat([
    {
        "id": "dnvp",
        "legend": "MNVP",
        "name": "MNVP",
        "seats": Math.round(Q.dnvp_zel*1),
    },
    {
        "id": "nsdap",
        "legend": "NSDAP",
        "name": "NSDAP",
        "seats": Math.round(Q.nsdap_zel*1),
    },
]);


if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("saxony_landtag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#saxony_landtag").datum(data).call(parliament);
}
!}
go-to: coalition_menu

