Q.ddp_zel = (Q.workers_ddp * Q.workers * 1.05) + (Q.old_middle_ddp * Q.old_middle * 1.1) + (Q.new_middle_ddp * Q.new_middle * 1.1) + (Q.peasants_ddp * Q.peasants * 0.9) + (Q.rural_ddp * Q.rural * 0.9) + (Q.catholics_ddp * Q.catholics * 0.8) + (Q.minorieties_ddp * Q.minorieties * 0.5) + (Q.unemployed_ddp * Q.unemployed * 0.9) + (Q.ddp_zel_mod * 10);
Q.z_zel = (Q.workers_z * Q.workers * 1.05) + (Q.old_middle_z * Q.old_middle * 1.1) + (Q.new_middle_z * Q.new_middle * 1.1) + (Q.peasants_z * Q.peasants * 0.9) + (Q.rural_z * Q.rural * 0.9) + (Q.catholics_z * Q.catholics * 0.8) + (Q.minorieties_z * Q.minorieties * 0.5) + (Q.unemployed_z * Q.unemployed * 0.9) + (Q.z_zel_mod * 10);
