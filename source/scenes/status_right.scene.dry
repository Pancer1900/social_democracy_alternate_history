= Global/Wide Economic Indicators

Investment: [? if investment < -0.1 : <span style="color: #bd0000;">Collapse</span> ?][? if investment < 0.05 and investment >= -0.1 : <span style="color: #e95448;">Regerssion</span> ?][? if investment > 0.05 and investment <= 0.2 : <span style="color: #d2ce5e;">Slowdown</span> ?][? if investment > 0.2 and investment <= 0.4 : <span style="color: #aad454;">Stable</span> ?][? if investment > 0.4 : <span style="color: #47d62c;">Growing</span> ?]

Forein Investment: [? if investment_forein < -0.1 : <span style="color: #bd0000;">Collapse</span> ?][? if investment_forein < 0.05 and investment_forein >= -0.1 : <span style="color: #e95448;">Regerssion</span> ?][? if investment_forein > 0.05 and investment_forein <= 0.2 : <span style="color: #d2ce5e;">Slowdown</span> ?][? if investment_forein > 0.2 and investment_forein <= 0.4 : <span style="color: #aad454;">Stable</span> ?][? if investment_forein > 0.4 : <span style="color: #47d62c;">Growing</span> ?]

Trade Status: [? if trade_stability < -0.1 : <span style="color: #bd0000;">Crisis</span> ?][? if trade_stability < 0 and trade_stability >= -0.1 : <span style="color: #e95448;">Unstable</span> ?][? if trade_stability > 0 and trade_stability <= 0.1 : <span style="color: #d2ce5e;">Low</span> ?][? if trade_stability > 0.1 and trade_stability <= 0.2 : <span style="color: #aad454;">Stable</span> ?][? if trade_stability > 0.3 : <span style="color: #47d62c;">Growing</span> ?]

Global Economy: [? if global_eco < -0.1 : <span style="color: #bd0000;">Global Recession</span> ?][? if global_eco < 0 and global_eco >= -0.1 : <span style="color: #e95448;">Mild Recession</span> ?][? if global_eco > 0 and global_eco <= 0.1 : <span style="color: #d2ce5e;">Slowing down</span> ?][? if global_eco > 0.1 and global_eco <= 0.2 : <span style="color: #aad454;">Stable</span> ?][? if global_eco > 0.3 : <span style="color: #47d62c;">Growing</span> ?]

Global Trade Networks: [? if global_trade < -0.1 : <span style="color: #bd0000;">Global Recession</span> ?][? if global_trade < 0 and global_trade >= -0.1 : <span style="color: #e95448;">Obstructed</span> ?][? if global_trade > 0 and global_trade <= 0.1 : <span style="color: #d2ce5e;">Stable</span> ?][? if global_trade > 0.1 : <span style="color: #aad454;">Developing</span> ?]

[? if oil_crisis = 1: Status of the oil crisis affecting Merkopia: [? if oil_crisis_mer <= 0 : <span style="color: #aad454;">Stabilised</span> ?][? if oil_crisis_mer > 0 and oil_crisis_mer <= 0.1 : <span style="color: #ffbf17;">Affecting</span> ?][? if oil_crisis_mer > 0.1 and oil_crisis_mer <= 0.2 : <span style="color: #e95448;">Severe</span> ?][? if oil_crisis_mer > 0.3 : <span style="color: #bd0000;">Full Crisis</span> ?] ?]

[? if oil_crisis = 1: Status of the Global Oil Crisis: [? if oil_crisis_global <= 0 : <span style="color: #aad454;">Stabilised</span> ?][? if oil_crisis_global > 0 and oil_crisis_global <= 0.1 : <span style="color: #ffbf17;">Affecting</span> ?][? if oil_crisis_global > 0.1 and oil_crisis_global <= 0.2 : <span style="color: #e95448;">Severe</span> ?][? if oil_crisis_global > 0.3 : <span style="color: #bd0000;">Global Crisis</span> ?] ?]

