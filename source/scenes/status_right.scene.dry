@politics_party
on-display: {!
data = [];
if (Q.revolutionaries_split == 0) {
    data.push({
            "id": "rev",
            "legend": "Revolutionaries",
            "name": "Revolutionaries",
            "seats": Math.round(Q.rev_seats*2),
            });
}
if (Q.left_split == 0) {
    data.push({
            "id": "lef",
            "legend": "Left",
            "name": "Left",
            "seats": Math.round(Q.lef_seats*2),
            });
}
if (Q.agrarnians_split == 0) {
    data.push({
            "id": "agr",
            "legend": "Agrariarins",
            "name": "Agrariarins",
            "seats": Math.round(Q.agr_seats*2),
            });
}
if (Q.centrists_resign == 0) {
    data.push({
            "id": "cen",
            "legend": "Centrists",
            "name": "Centrists",
            "seats": Math.round(Q.cen_seats*2),
            });
}
if (Q.unions_independent == 0) {
    data.push({
            "id": "lab",
            "legend": "Labour",
            "name": "Labour",
            "seats": Math.round(Q.lab_seats*2),
            });
}
if (Q.reformists_resigned == 0) {
    data.push({
            "id": "ref",
            "legend": "Reformist",
            "name": "Reformist",
            "seats": Math.round(Q.ref_seats*2),
            });
}

if (window && d3) {
    var width = 200; 
    var height = 100;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50; 
        height = width;
        document.getElementById("reichstag").style.height = screenWidth/2 + "px";
    } 

    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#reichstag").datum(data).call(parliament);
}
!}

= Election results

{!<svg id="reichstag" style="width: 200px; height: 100px;"> </svg>!}

= Internal Politics of the <span style="color: #dc0200;">[+ spd_name +]</span>

Party Chairman: [+ spd_leader +]

Internal dissent: [+ dissent_percent : dissent +]

Resources available: [+ resources +]

Paramilitary Resources: [+ para_resources  +]

Party Radicalisation: [? if radicalization < 0 : <span style="color: #0062ff;">Full Reformism</span> ?][? if radicalization < 3 and radicalization >= 0 : <span style="color: #3660a3;">Low</span> ?][? if radicalization < 7 and radicalization >= 3 : Moderate ?][? if radicalization < 12 and radicalization >= 7 : <span style="color: #c73857;">Hight</span> ?][? if radicalization >= 12 : <span style="color: #940121;">Full Revolutionary</span> ?]

Party Democratisation: [? if democratization < 0 : <span style="color: #940121;">Anti-Democratic Bulwark</span> ?][? if democratization < 3 and democratization >= 0 : <span style="color: #c73857;">Low</span> ?][? if democratization < 7 and democratization >= 3 : Moderate ?][? if democratization < 12 and democratization >= 7 : <span style="color: #a8a454;">Hight</span> ?][? if democratization >= 12 : <span style="color: #c9c010;">Full Democrats</span> ?]

Party Pacifism: [? if pacifism < 0 : <span style="color: #940121;">Anti-Pacifist Action</span> ?][? if pacifism < 3 and pacifism >= 0 : <span style="color: #c73857;">Low</span> ?][? if pacifism < 7 and pacifism >= 3 : Moderate ?][? if pacifism < 12 and pacifism >= 7 : <span style="color: #3660a3;">Hight</span> ?][? if pacifism >= 12 : <span style="color: #0062ff;">Full Pacifists</span> ?]

Reconciliation with the Liberal Parties: [? if liberal_reconciliation < 0 : <span style="color: #000000;">Better Dead than Red</span> ?][? if liberal_reconciliation < 6 and liberal_reconciliation >= 0 : <span style="color: #9e5c00;">Low</span> ?][? if liberal_reconciliation < 12 and liberal_reconciliation >= 6 : <span style="color: #999e00;">Warming Up</span> ?][? if liberal_reconciliation < 18 and liberal_reconciliation >= 12 : <span style="color: #6c9e00;">Mild Reconciliation</span> ?][? if liberal_reconciliation >= 18 : <span style="color: #159e00;">Full Reconciliation</span> ?]

= Internal Factions of the Party

[? if revolutionaries_split == 0: {!<span class="tooltip-text" title="Revolutionaries want to crush the Burgoise state as fast as possible and they serve as a push for revolution" style="color: #b50000;">Revolutionaries</span>!} strength: [+ revolutionaries_strength : strength +], dissent: [+ revolutionaries_dissent : dissent +] ?]

[? if revolutionaries_split == 1: <span class="tooltip-text" title="Revolutionaries want to crush the Burgoise state as fast as possible and they serve as a push for revolution" style="color: #b50000;">Revolutionaries</span> Split form the Party ?]

[? if left_split == 0: {!<span class="tooltip-text" title="The Left are close to revolutionaries but aren't as radical as them. They believe in a more radical path for the party, but they dont view the revolution as a immedete goal" style="color: #940000;">Left</span>!} strength: [+ left_strength : strength +], dissent: [+ left_dissent : dissent +] ?]

[? if left_split == 1: <span class="tooltip-text" title="The Left are close to revolutionaries but aren't as radical as them. They believe in a more radical path for the party, but they dont view the revolution as a immedete goal" style="color: #940000;">Left</span> Split form the Party ?]

[? if agrarnians_split == 0: {!<span class="tooltip-text" title="Agrarians are the rular base of the party and improving the lives of the peasants and farmers are their main goal" style="color: #dd5b00;">Agrarinas</span>!} strength: [+ agrarnians_strength : strength +], dissent: [+ agrarnians_dissent : dissent +] ?]

[? if agrarnians_split == 1: <span class="tooltip-text" title="Agrarians are the rular base of the party and improving the lives of the peasants and farmers are their main goal" style="color: #dd5b00;">Agrarinas</span> Split form the Party ?]

[? if centrists_resign == 0: {!<span class="tooltip-text" title="The Center is a faction of Center Marxists, between reform and revolution" style="color: #ff1919;">Center</span>!} strength: [+ center_strength : strength +], dissent: [+ center_dissent : dissent +] ?]

[? if unions_independent == 0: {!<span class="tooltip-text" title="Labor's goal is economic reform and benefits for organized workers" style="color: #c96b65;">Labour</span>!} strength: [+ labor_strength : strength +], dissent: [+ labor_dissent : dissent +] ?]

[? if unions_independent == 1: <span class="tooltip-text" title="Labor's goal is economic reform and benefits for organized workers" style="color: #c96b65;">Labour</span> Split form the Party ?]

[? if reformists_resigned == 0: {!<span class="tooltip-text" title="Reformists are pragmatic participants in government, and seek to expand the welfare state and defend democracy" style="color: #dc0200;">Reformists</span>!} strength: [+ reformist_strength : strength +], dissent: [+ reformist_dissent : dissent +] ?]

[? if revolutionaries_split == 1: <span class="tooltip-text" title="Reformists are pragmatic participants in government, and seek to expand the welfare state and defend democracy" style="color: #dc0200;">Reformists</span> Split form the Party ?]


